<UserControl
    x:Class="ImageViewer.Controls.Volume3DViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helix="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:localization="clr-namespace:ImageViewer.Localization"
    xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
    automation:AutomationProperties.Name="{localization:UiText Volume3DViewerName}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 默认深色主题。必须放在 UserControl.Resources：放在子级 Grid.Resources 会遮蔽外层，
                     使 Theme/ThemeDictionary 属性切换到别的字典时不生效。 -->
                <ResourceDictionary Source="pack://application:,,,/ImageViewerControl;component/Themes/ViewerTheme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ViewerBackdropSolidBrush}">
        <Grid.ContextMenu>
            <ContextMenu x:Name="threeDContextMenu" x:FieldModifier="internal" Opened="OnThreeDContextMenuOpened">
                <ContextMenu.Resources>
                    <Style TargetType="ContextMenu">
                        <Setter Property="Background" Value="{DynamicResource ViewerMenuPopupBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ViewerMenuBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ContextMenu">
                                    <Border Background="{DynamicResource ViewerMenuPopupBrush}" BorderBrush="{DynamicResource ViewerMenuBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" SnapsToDevicePixels="True">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Top">
                                                <TextBlock Margin="8,6,8,0"
                                                           Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                                                           FontSize="11"
                                                           Text="{localization:UiText MenuSearch}" />
                                                <TextBox x:Name="PART_MenuSearchBox"
                                                         Margin="4"
                                                         Padding="8,5"
                                                         HorizontalAlignment="Stretch"
                                                         Background="{DynamicResource ViewerSurfaceAltBrush}"
                                                         Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                                                         BorderBrush="{DynamicResource ViewerMenuBorderBrush}"
                                                         CaretBrush="{DynamicResource ViewerTextPrimaryBrush}"
                                                         SelectionBrush="{DynamicResource ViewerSelectionBrush}"
                                                         ToolTip="{localization:UiText MenuSearch}"
                                                         automation:AutomationProperties.Name="{localization:UiText MenuSearch}"
                                                         automation:AutomationProperties.HelpText="{localization:UiText MenuSearch}"
                                                         TextChanged="OnThreeDMenuSearchTextChanged"
                                                         PreviewKeyDown="OnThreeDMenuSearchPreviewKeyDown" />
                                                <TextBlock x:Name="PART_MenuSearchMatchCount"
                                                           Margin="12,4,12,2"
                                                           Foreground="{DynamicResource ViewerAccentBrush}"
                                                           Text="{localization:UiText MenuSearchMatchCount}"
                                                           automation:AutomationProperties.LiveSetting="Polite"
                                                           Visibility="Collapsed" />
                                                <TextBlock x:Name="PART_MenuSearchNoResults"
                                                           Margin="12,4,12,8"
                                                           Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                                                           Text="{localization:UiText MenuSearchNoResults}"
                                                           automation:AutomationProperties.LiveSetting="Polite"
                                                           Visibility="Collapsed" />
                                                <Separator />
                                            </StackPanel>
                                            <ItemsPresenter SnapsToDevicePixels="True" />
                                        </DockPanel>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Grid>
                                        <Border x:Name="menuItemBorder" Background="Transparent" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" x:Name="checkGlyph" Visibility="Collapsed"
                                                      Data="M 0,4 L 3.5,7.5 L 8,1" Stroke="{DynamicResource ViewerAccentBrush}" StrokeThickness="1.5"
                                                      Margin="10,0,4,0" VerticalAlignment="Center" Width="8" Height="9" />
                                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  RecognizesAccessKey="True" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" x:Name="shortcutText"
                                                           Text="{TemplateBinding InputGestureText}"
                                                           Foreground="{DynamicResource ViewerTextSecondaryBrush}" Margin="24,0,10,0"
                                                           VerticalAlignment="Center" FontSize="11" />
                                                <Path Grid.Column="3" x:Name="submenuArrow" Visibility="Collapsed"
                                                      Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource ViewerTextSecondaryBrush}" StrokeThickness="1.5"
                                                      Margin="0,0,10,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Popup x:Name="SubMenuPopup" AllowsTransparency="True"
                                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                               Placement="Right" VerticalOffset="-2" HorizontalOffset="-2"
                                               PopupAnimation="Slide" Focusable="False">
                                            <Border Background="{DynamicResource ViewerMenuPopupBrush}" BorderBrush="{DynamicResource ViewerMenuBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="menuItemBorder" Property="Background" Value="{DynamicResource ViewerButtonHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="menuItemBorder" Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource ViewerTextDisabledBrush}" />
                                            <Setter TargetName="shortcutText" Property="Foreground" Value="{DynamicResource ViewerTextMutedBrush}" />
                                            <Setter TargetName="submenuArrow" Property="Stroke" Value="{DynamicResource ViewerTextMutedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="True">
                                            <Setter TargetName="submenuArrow" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="shortcutText" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="Separator">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Separator">
                                    <Border Height="1" Background="{DynamicResource ViewerMenuBorderBrush}" Margin="8,3" SnapsToDevicePixels="True" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="{DynamicResource ViewerSurfaceAltBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ViewerMenuBorderBrush}" />
                        <Setter Property="CaretBrush" Value="{DynamicResource ViewerTextPrimaryBrush}" />
                        <Setter Property="SelectionBrush" Value="{DynamicResource ViewerSelectionBrush}" />
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="{localization:UiText Menu3DResetCamera}" ToolTip="{localization:UiText Menu3DResetCameraTooltip}" Click="OnResetCameraClick" />
                <MenuItem Header="{localization:UiText Menu3DFitVolume}" ToolTip="{localization:UiText Menu3DFitVolumeTooltip}" Click="OnFitVolumeClick" />
                <Separator />
                <MenuItem Header="{localization:UiText Menu3DFrontView}" ToolTip="{localization:UiText Menu3DFrontViewTooltip}" Click="OnFrontViewClick" />
                <MenuItem Header="{localization:UiText Menu3DBackView}" ToolTip="{localization:UiText Menu3DBackViewTooltip}" Click="OnBackViewClick" />
                <MenuItem Header="{localization:UiText Menu3DTopView}" ToolTip="{localization:UiText Menu3DTopViewTooltip}" Click="OnTopViewClick" />
                <MenuItem Header="{localization:UiText Menu3DBottomView}" ToolTip="{localization:UiText Menu3DBottomViewTooltip}" Click="OnBottomViewClick" />
                <MenuItem Header="{localization:UiText Menu3DSideView}" ToolTip="{localization:UiText Menu3DSideViewTooltip}" Click="OnSideViewClick" />
                <MenuItem Header="{localization:UiText Menu3DOppositeSideView}" ToolTip="{localization:UiText Menu3DOppositeSideViewTooltip}" Click="OnOppositeSideViewClick" />
                <MenuItem Header="{localization:UiText Menu3DIsometricView}" ToolTip="{localization:UiText Menu3DIsometricViewTooltip}" Click="OnIsometricViewClick" />
                <Separator />
                <MenuItem Header="{localization:UiText Menu3DShowCoordinateSystem}" ToolTip="{localization:UiText Menu3DShowCoordinateSystemTooltip}" IsCheckable="True" IsChecked="True" Click="OnCoordinateSystemClick" />
                <MenuItem Header="{localization:UiText Menu3DShowBoundingBox}" ToolTip="{localization:UiText Menu3DShowBoundingBoxTooltip}" IsCheckable="True" IsChecked="True" Click="OnBoundingBoxClick" />
                <MenuItem Header="{localization:UiText Menu3DShowAxialPlane}" ToolTip="{localization:UiText Menu3DShowAxialPlaneTooltip}" IsCheckable="True" IsChecked="True" Click="OnAxialPlaneClick" />
                <MenuItem Header="{localization:UiText Menu3DShowCoronalPlane}" ToolTip="{localization:UiText Menu3DShowCoronalPlaneTooltip}" IsCheckable="True" Click="OnCoronalPlaneClick" />
                <MenuItem Header="{localization:UiText Menu3DShowSagittalPlane}" ToolTip="{localization:UiText Menu3DShowSagittalPlaneTooltip}" IsCheckable="True" Click="OnSagittalPlaneClick" />
                <Separator />
                <MenuItem Header="{localization:UiText Menu3DIncreaseTransparency}" ToolTip="{localization:UiText Menu3DIncreaseTransparencyTooltip}" Click="OnIncreaseTransparencyClick" />
                <MenuItem Header="{localization:UiText Menu3DDecreaseTransparency}" ToolTip="{localization:UiText Menu3DDecreaseTransparencyTooltip}" Click="OnDecreaseTransparencyClick" />
                <Separator />
                <MenuItem Header="{localization:UiText Menu3DSwitchToAxialSlice}" ToolTip="{localization:UiText Menu3DSwitchToAxialSliceTooltip}" Click="OnSwitchToAxialSliceClick" />
            </ContextMenu>
        </Grid.ContextMenu>
        <helix:Viewport3DX
            x:Name="viewport"
            BackgroundColor="{DynamicResource ViewerViewportBackgroundColor}"
            CameraRotationMode="Trackball"
            ShowCoordinateSystem="True"
            ShowFrameRate="False"
            IsShadowMappingEnabled="False" />
        <Border
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="12"
            Padding="8,5"
            Background="{DynamicResource ViewerSurfaceOverlayMenuBrush}"
            CornerRadius="8">
            <TextBlock x:Name="volumeStatusText" Foreground="{DynamicResource ViewerTextPrimaryBrush}" automation:AutomationProperties.Name="{localization:UiText Volume3DStatusName}" automation:AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</UserControl>
