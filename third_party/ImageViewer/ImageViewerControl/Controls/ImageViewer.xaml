                            <MenuItem x:Name="preferShaderPseudoColorMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.TogglePreferShaderPseudoColor}" Header="{localization:UiText MenuPreferShaderPseudoColor}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PreferShaderPseudoColorChecked}" />
                            <MenuItem x:Name="allowCpuPseudoColorFallbackMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleAllowCpuPseudoColorFallback}" Header="{localization:UiText MenuAllowCpuFallback}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.AllowCpuPseudoColorFallbackChecked}" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="{localization:UiText MenuCacheMaintenance}">
                        <MenuItem x:Name="clearPyramidCacheMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ClearPyramidCache}" Header="{localization:UiText MenuClearPyramidCache}" IsEnabled="{Binding MenuState.Analysis.EnableClearPyramidCache}" />
                        <MenuItem x:Name="clearAnalysisCacheMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ClearAnalysisCache}" Header="{localization:UiText MenuClearAnalysisCache}" IsEnabled="{Binding MenuState.Analysis.EnableClearAnalysisCache}" />
                    </MenuItem>
                    <MenuItem x:Name="showRenderStatusMenuItem" x:FieldModifier="internal" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ShowRenderStatus}" Header="{localization:UiText MenuShowRenderStatus}" IsEnabled="{Binding MenuState.Analysis.EnableShowRenderStatus}" />
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Canvas x:Name="canvas" SnapsToDevicePixels="True">
            <!-- 图像容器，负责缩放和平移 -->
            <Canvas x:Name="imageContainer" x:FieldModifier="internal" SnapsToDevicePixels="True">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="orientationScaleTransform" />
                        <RotateTransform x:Name="orientationRotateTransform" />
                        <ScaleTransform x:Name="scaleTransform" />
                        <TranslateTransform x:Name="translateTransform" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- 图像显示 -->
                <Image x:Name="image" x:FieldModifier="internal"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       automation:AutomationProperties.Name="{localization:UiText ImageDisplayAreaName}"
                       automation:AutomationProperties.HelpText="{localization:UiText ImageDisplayAreaHelpText}" />

                <Canvas x:Name="snapGridCanvas" IsHitTestVisible="False" Opacity="0.6" />

                <!-- ROI 覆盖层 -->
                <Canvas x:Name="overlayCanvas" SnapsToDevicePixels="True">
                    <Canvas x:Name="committedOverlayCanvas" SnapsToDevicePixels="True" />
                    <Canvas x:Name="selectionOverlayCanvas" SnapsToDevicePixels="True" />
                    <Canvas x:Name="activeOverlayCanvas" SnapsToDevicePixels="True" />
                </Canvas>
                
                <!-- 像素网格层 -->
                <Canvas x:Name="pixelGridCanvas" IsHitTestVisible="False" Opacity="0.5" />
            </Canvas>
        </Canvas>

        <Canvas x:Name="screenOverlayCanvas" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- 缩放比例徽标：跟随光标短暂显示，淡入淡出 -->
            <Border x:Name="zoomBadgeBorder" x:FieldModifier="internal"
                    Padding="10,5"
                    Background="{DynamicResource ViewerSurfaceBrush}"
                    BorderBrush="{DynamicResource ViewerAccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    Opacity="0">
                <Border.Effect>
                    <effects:DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ViewerShadowColor}" />
                </Border.Effect>
                <TextBlock x:Name="zoomBadgeTextBlock" x:FieldModifier="internal"
                           Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <Border x:Name="diagnosticErrorBorder"
            x:FieldModifier="internal"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="16"
            Padding="12,9,8,9"
            Style="{StaticResource ViewerErrorPanelStyle}"
            Panel.ZIndex="120"
            Visibility="{Binding HasDiagnosticError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="True">
                <Button x:Name="diagnosticErrorDismissButton" x:FieldModifier="internal"
                    DockPanel.Dock="Right"
                    Margin="12,0,0,0"
                    Content="×"
                        ToolTip="{localization:UiText MenuDismissError}"
                    automation:AutomationProperties.Name="{localization:UiText MenuDismissError}"
                    Click="OnDismissDiagnosticErrorClick"
                    Style="{StaticResource ViewerErrorDismissButtonStyle}" />
                <TextBlock x:Name="diagnosticErrorIconTextBlock" x:FieldModifier="internal"
                    DockPanel.Dock="Left"
                    Text="⚠"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ViewerErrorBrush}"
                    FontSize="15"
                    FontWeight="Bold" />
                 <TextBlock x:Name="diagnosticErrorTextBlock" x:FieldModifier="internal"
                     Text="{Binding DiagnosticErrorText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   MaxWidth="360"
                   automation:AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>

        <!-- 十字准星（不随图像缩放） -->
        <Canvas IsHitTestVisible="False">
            <Line x:Name="crosshairH" Stroke="{DynamicResource ViewerAccentBrush}" StrokeThickness="1.25" Visibility="Collapsed" />
            <Line x:Name="crosshairV" Stroke="{DynamicResource ViewerAccentBrush}" StrokeThickness="1.25" Visibility="Collapsed" />
        </Canvas>

        <!-- 坐标显示 -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10"
                Padding="10,6"
                Background="{DynamicResource ViewerSurfaceOverlayBrush}"
                BorderBrush="{DynamicResource ViewerPopupBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=coordTextBlock}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="coordTextBlock"
                       Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                       FontWeight="SemiBold" />
        </Border>

        <!-- 比例尺 -->
        <Canvas x:Name="scaleBarCanvas" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Bottom" 
                Margin="10,0,0,35" 
                Width="150" 
                Height="30" 
                IsHitTestVisible="False" 
                Visibility="Collapsed">
            <Polyline x:Name="scaleBarLine" Stroke="{DynamicResource ViewerAccentBrush}" StrokeThickness="2" Points="0,0 0,10 100,10 100,0" />
            <TextBlock x:Name="scaleBarText" Text="{localization:UiText ScaleBarDefault}" Foreground="{DynamicResource ViewerTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Canvas.Left="30" Canvas.Top="-5"/>
        </Canvas>

        <!-- Analysis overlays stay inside the image viewport. -->
        <Border x:Name="histogramPanel"
                Margin="10,0,10,40"
                Padding="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource ViewerFloatingPanelStyle}"
                Width="266"
                Height="160"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Grid>
                <TextBlock Text="{localization:UiText HistogramPanelTitle}" Foreground="{DynamicResource ViewerTextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" FontWeight="SemiBold" Opacity="0.95"/>
                <Canvas x:Name="histogramCanvas" Margin="0,15,0,0" Width="256" Height="140" ClipToBounds="True"/>
            </Grid>
        </Border>

        <!-- 灰度剖面图面板 -->
        <Border x:Name="profilePanel"
                Margin="10,0,10,40"
                Padding="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Style="{StaticResource ViewerFloatingPanelStyle}"
                Width="266"
                Height="160"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Grid>
                <TextBlock Text="{localization:UiText ProfilePanelTitle}" Foreground="{DynamicResource ViewerTextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" FontWeight="SemiBold" Opacity="0.95"/>
                <Canvas x:Name="profileCanvas" Margin="0,15,0,0" Width="256" Height="140" ClipToBounds="True"/>
            </Grid>
        </Border>

        <Border x:Name="emptyStatePanel"
                Width="420"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
            Panel.ZIndex="90">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ViewerFloatingPanelStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}" />
                                <Condition Binding="{Binding IsImageLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Width="360">
                <Border Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16"
                        Background="{DynamicResource ViewerAccentSoftBrush}"
                        BorderBrush="{DynamicResource ViewerAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20">
                    <Viewbox Margin="16">
                        <Canvas Width="40" Height="40">
                            <Path Data="M4,8 H36 V32 H4 Z" Stroke="{DynamicResource ViewerAccentBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" />
                            <Path Data="M8,26 L16,18 L24,26 L29,21 L34,28" Stroke="{DynamicResource ViewerAccentBrush}" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Ellipse Canvas.Left="28" Canvas.Top="12" Width="4" Height="4" Fill="{DynamicResource ViewerAccentBrush}" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <TextBlock Text="{localization:UiText EmptyStateTitle}"
                           Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />

                <TextBlock Text="{localization:UiText EmptyStateDescription}"
                           Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Border Margin="0,0,8,8" Padding="10,4" Background="{DynamicResource ViewerSurfaceInsetBrush}" BorderBrush="{DynamicResource ViewerInsetBorderBrush}" BorderThickness="1" CornerRadius="999">
                        <TextBlock Text="{localization:UiText EmptyStateDropLoad}" Foreground="{DynamicResource ViewerTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border Margin="0,0,8,8" Padding="10,4" Background="{DynamicResource ViewerSurfaceInsetBrush}" BorderBrush="{DynamicResource ViewerInsetBorderBrush}" BorderThickness="1" CornerRadius="999">
                        <TextBlock Text="{localization:UiText EmptyStateBackgroundRetry}" Foreground="{DynamicResource ViewerTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border Margin="0,0,8,8" Padding="10,4" Background="{DynamicResource ViewerSurfaceInsetBrush}" BorderBrush="{DynamicResource ViewerInsetBorderBrush}" BorderThickness="1" CornerRadius="999">
                        <TextBlock Text="{localization:UiText EmptyStateTiledRendering}" Foreground="{DynamicResource ViewerTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </WrapPanel>

                <Button Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        Click="OnToolbarFileCommandClick"
                        Content="{localization:UiText MenuOpenImageFile}"
                        Tag="{x:Static controls:ImageViewerFileMenuTags.OpenImage}"
                        Style="{StaticResource ViewerToolbarPrimaryButtonStyle}" />

                <TextBlock Text="{localization:UiText EmptyStateHint}"
                           Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                           FontSize="11"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <!-- 当前工具状态（绘制期间持续显示，直到完成或取消） -->
        <Border x:Name="activeToolBanner" x:FieldModifier="internal"
                MaxWidth="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="16,0,16,12"
                Padding="12,8"
                Background="{DynamicResource ViewerAccentSoftBrush}"
                BorderBrush="{DynamicResource ViewerAccentBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Panel.ZIndex="125"
                Visibility="Collapsed"
                automation:AutomationProperties.LiveSetting="Polite">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="{localization:UiText ActiveToolCancel}"
                        Click="OnActiveToolCancelClick"
                        ToolTip="{localization:UiText ActiveToolCancel}"
                        Margin="12,0,0,0"
                        Padding="12,5"
                        Style="{StaticResource ViewerToolbarButtonStyle}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{localization:UiText ActiveToolPrefix}"
                               Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="activeToolNameTextBlock" x:FieldModifier="internal"
                               Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="4,0,10,0"
                               VerticalAlignment="Center"
                               automation:AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{localization:UiText ActiveToolHint}"
                               Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 状态提示横幅（顶部居中，约 3 秒自动消失） -->
        <Border x:Name="statusHintBorder" x:FieldModifier="internal"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="16,14"
                Padding="16,10"
                Background="{DynamicResource ViewerSurfaceBrush}"
                BorderBrush="{DynamicResource ViewerPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Panel.ZIndex="130"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border.Effect>
                <effects:DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="{DynamicResource ViewerShadowColor}" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="statusHintIconTextBlock" x:FieldModifier="internal"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Visibility="Collapsed" />
                <TextBlock x:Name="statusHintTextBlock" x:FieldModifier="internal"
                           Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <Border x:Name="imageLoadPanel"
                Margin="16"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"

                Panel.ZIndex="110"
                Width="420"
                Visibility="{Binding IsImageLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ViewerFloatingPanelStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ImageLoadHasError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ViewerErrorSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ViewerErrorBorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="10" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Width="384">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Ellipse Stroke="{DynamicResource ViewerChipHoverBrush}" StrokeThickness="4" />
                    <Ellipse x:Name="loadingSpinner"
                             Stroke="{DynamicResource ViewerAccentBrush}"
                             StrokeDashArray="1.2 2.5"
                             StrokeDashCap="Round"
                             StrokeThickness="4">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImageLoadHasError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="loadingSpinnerRotate" CenterX="24" CenterY="24" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Text="⚠"
                               Foreground="{DynamicResource ViewerErrorBrush}"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding ImageLoadHasError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="loadingSpinnerRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:1.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock x:Name="imageLoadStatusTextBlock" x:FieldModifier="internal"
                               Text="{Binding ImageLoadStatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="⚠"
                               Foreground="{DynamicResource ViewerErrorBrush}"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,6,0,0"
                               Visibility="{Binding ImageLoadHasError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ImageLoadProgress, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource ViewerProgressBarStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImageLoadHasError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Padding="14,6"
                            Click="OnRetryImageLoadClick"
                            Content="{localization:UiText ImageLoadRetry}"
                            Visibility="{Binding CanRetryImageLoad, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource ViewerErrorActionButtonStyle}" />
                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Padding="14,6"
                            Click="OnCancelImageLoadClick"
                            Content="{localization:UiText ImageLoadCancel}"
                            Visibility="{Binding CanCancelImageLoad, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 拖放视觉反馈：拖入可打开文件时显示，提示松开即可打开 -->
        <Border x:Name="dropHintOverlay" x:FieldModifier="internal"
                Margin="24"
                Background="{DynamicResource ViewerSurfaceOverlayAltBrush}"
                BorderBrush="{DynamicResource ViewerAccentBorderBrush}"
                BorderThickness="2"
                CornerRadius="16"
                IsHitTestVisible="False"
                Panel.ZIndex="140"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{localization:UiText DropOverlayHint}"
                           Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>

        <Grid x:Name="rightOverlayPanel" Grid.Row="2" Grid.Column="1"
              Width="300" Background="{DynamicResource ViewerSurfaceBrush}"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="2*" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=roiListPanel}" Value="Collapsed">
                                    <Setter Property="Height" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="3*" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=roiPropertyPanel}" Value="Collapsed">
                                    <Setter Property="Height" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>
            <Border x:Name="infoPanel"
                    x:FieldModifier="internal"
                    BorderBrush="{DynamicResource ViewerPanelBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Visible">
                <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=infoTextBlock}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <TextBlock x:Name="infoTextBlock" Margin="10,8" Foreground="{DynamicResource ViewerTextPrimaryBrush}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <Border x:Name="roiListPanel"
                    x:FieldModifier="internal"
                    Grid.Row="1"
                    Padding="10,8"
                    BorderBrush="{DynamicResource ViewerPanelBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{localization:UiText RoiListTitle}"
                                   Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="roiListCountText"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                                   Text="{Binding ViewerState.AllRois.Count, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}({0})}" />
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <TextBox x:Name="roiFilterTextBox"
                                 Padding="7,4"
                                 Background="{DynamicResource ViewerSurfaceAltBrush}"
                                 Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ViewerChipBorderBrush}"
                                 TextChanged="OnRoiFilterTextChanged"
                                 ToolTip="{localization:UiText RoiListFilterTooltip}"
                                 automation:AutomationProperties.Name="{localization:UiText RoiListFilterAccessibleName}" />
                        <TextBlock Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                                   Text="{localization:UiText RoiListFilterAccessibleName}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=roiFilterTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ListBox Grid.Row="2"
                             x:Name="roiListBox" x:FieldModifier="internal"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                             automation:AutomationProperties.Name="{localization:UiText RoiListAccessibleName}"
                             ItemsSource="{Binding ViewerState.AllRois, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             SelectedItem="{Binding ViewerState.SelectedRoi, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                                                   Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                                                   FontSize="10"
                                                   Text="{Binding DisplayTypeName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                              ToolTip="{localization:UiText RoiListToggleVisibleTooltip}"
                                              Content="{localization:UiText RoiListToggleVisible}" />
                                    <CheckBox Grid.Column="2"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                                              IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                              ToolTip="{localization:UiText RoiListToggleLockedTooltip}"
                                              Content="{localization:UiText RoiListToggleLocked}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Padding="8,3"
                                Margin="0,0,6,0"
                                Content="{localization:UiText RoiListZoomButton}"
                                Click="OnRoiListZoomClick"
                                IsEnabled="{Binding MenuState.View.ZoomToSelectionEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource ViewerToolbarButtonStyle}"
                                ToolTip="{localization:UiText RoiListZoomTooltip}" />
                        <Button Padding="8,3"
                                Content="{localization:UiText RoiListDeleteButton}"
                                Click="OnRoiListDeleteClick"
                                IsEnabled="{Binding MenuState.Context.DeleteSelectedEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource ViewerToolbarButtonStyle}"
                                ToolTip="{localization:UiText RoiListDeleteTooltip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="roiPropertyPanel"
                    Grid.Row="2"
                    Padding="10,8"
                    BorderBrush="{DynamicResource ViewerPanelBorderBrush}"
                    BorderThickness="1,1,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{localization:UiText PropertyPanelTitle}"
                                   Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button x:Name="circularCaliperSettingsButton"
                                x:FieldModifier="internal"
                                Grid.Column="1"
                                Padding="8,3"
                                Margin="8,0,0,0"
                                Content="{localization:UiText QuickCircularCaliperSettings}"
                                ToolTip="{localization:UiText QuickCircularCaliperSettingsTooltip}"
                                Click="OnQuickCircularCaliperSettingsClick"
                                Style="{StaticResource ViewerToolbarPrimaryButtonStyle}"
                                Visibility="Collapsed"
                                automation:AutomationProperties.Name="{localization:UiText QuickCircularCaliperSettings}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="roiPropertyEditorHost" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="statusBarBorder" x:FieldModifier="internal"
                Grid.Row="3" Grid.ColumnSpan="2"
                Padding="10,4"
                Background="{DynamicResource ViewerSurfaceBrush}"
                BorderBrush="{DynamicResource ViewerPanelBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="statusBarTextBlock" x:FieldModifier="internal"
                           Grid.Column="0"
                           Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           automation:AutomationProperties.LiveSetting="Polite" />
                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="7,2"
                        Background="{DynamicResource ViewerAccentSoftBrush}"
                        BorderBrush="{DynamicResource ViewerAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        ToolTip="{Binding InteractionModeHint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        automation:AutomationProperties.LiveSetting="Polite">
                    <TextBlock Text="{Binding InteractionModeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                               FontWeight="Bold"
                               FontSize="11" />
                </Border>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Text="{localization:UiText StatusUnsavedMarker}"
                           Foreground="{DynamicResource ViewerAccentBrush}"
                           FontWeight="Bold"
                           Visibility="{Binding IsDirty, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                           automation:AutomationProperties.Name="{localization:UiText StatusUnsavedAccessibleName}" />
                <Border x:Name="calibrationBadge"
                        x:FieldModifier="internal"
                        Grid.Column="3"
                        Margin="10,0,0,0"
                        Padding="8,3"
                        Background="{DynamicResource ViewerAccentSoftBrush}"
                        BorderBrush="{DynamicResource ViewerAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        automation:AutomationProperties.Name="{localization:UiText CalibrationBadgeAccessibleName}"
                        automation:AutomationProperties.LiveSetting="Polite">
                    <TextBlock x:Name="calibrationBadgeTextBlock"
                               x:FieldModifier="internal"
                               MaxWidth="300"
                               Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                               FontWeight="Bold"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               automation:AutomationProperties.LiveSetting="Polite" />
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
