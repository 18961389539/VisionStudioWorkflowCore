<UserControl
    x:Class="ImageViewer.Controls.ImageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ImageViewer.Controls"
    xmlns:localization="clr-namespace:ImageViewer.Localization"
    xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
    xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="True"
    AllowDrop="True"
    UseLayoutRounding="True"
    automation:AutomationProperties.Name="{localization:UiText ViewerAccessibleName}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 默认深色主题。宿主可通过 ViewerTheme 属性或 Application.Resources 覆盖同键资源换肤。 -->
                <ResourceDictionary Source="pack://application:,,,/ImageViewerControl;component/Themes/ViewerTheme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <ControlTemplate x:Key="ViewerChromeButtonTemplate" TargetType="{x:Type ButtonBase}">
                <Border x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerButtonHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerButtonPressedBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ViewerAccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="ViewerFloatingPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ViewerSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ViewerPanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <effects:DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.28" Color="{DynamicResource ViewerShadowColor}" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ViewerSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ViewerTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="ViewerToolbarButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource ViewerSurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ViewerChipBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template" Value="{StaticResource ViewerChromeButtonTemplate}" />
            </Style>

            <Style x:Key="ViewerToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerToolbarButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource ViewerAccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ViewerAccentBorderBrush}" />
            </Style>

            <Style x:Key="ViewerErrorPanelStyle" TargetType="Border" BasedOn="{StaticResource ViewerFloatingPanelStyle}">
                <Setter Property="Background" Value="{DynamicResource ViewerErrorSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ViewerErrorBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="ViewerErrorActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerToolbarButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource ViewerErrorSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ViewerErrorBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
            </Style>

            <Style x:Key="ViewerErrorDismissButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource ViewerErrorBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource ViewerErrorBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template" Value="{StaticResource ViewerChromeButtonTemplate}" />
            </Style>

            <Style x:Key="ViewerToolbarToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource ViewerSurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ViewerChipBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template" Value="{StaticResource ViewerChromeButtonTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ViewerAccentSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ViewerAccentBorderBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ViewerProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{DynamicResource ViewerAccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource ViewerProgressTrackBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ViewerProgressBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="viewerLayout" Background="{DynamicResource ViewerBackdropBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="{DynamicResource ViewerSurfaceBrush}"
                BorderBrush="{DynamicResource ViewerPanelBorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <Border.Resources>
                <Style x:Key="DockedToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerToolbarButtonStyle}">
                    <Setter Property="Margin" Value="0,2,5,2" />
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="MinHeight" Value="28" />
                </Style>
            </Border.Resources>
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button x:Name="rightOverlayToggleButton" x:FieldModifier="internal"
                            Content="{localization:UiText RoiSidebarButton}"
                            Click="OnRightOverlayToggleClick"
                            Style="{StaticResource DockedToolbarButtonStyle}" />
                    <Button x:Name="moreCommandsButton" x:FieldModifier="internal"
                            Content="{localization:UiText ToolbarMoreCommands}"
                            Click="OnMoreCommandsClick"
                            Style="{StaticResource DockedToolbarButtonStyle}" />
                </WrapPanel>
                <Button x:Name="toolbarCompactButton" x:FieldModifier="internal"
                        HorizontalAlignment="Left"
                        Content="{localization:UiText ToolbarRestoreButton}"
                        Click="OnCompactToolbarClick"
                        ToolTip="{localization:UiText ToolbarRestoreHint}"
                        Style="{StaticResource DockedToolbarButtonStyle}"
                        Visibility="Collapsed" />
                <Border x:Name="toolbarPanel" x:FieldModifier="internal">
                    <WrapPanel>
                        <Button Content="{localization:UiText MenuOpenImageFile}"
                            Click="OnToolbarFileCommandClick"
                            Tag="{x:Static controls:ImageViewerFileMenuTags.OpenImage}"
                            ToolTip="{localization:UiText ToolbarOpenImageTooltip}"
                            automation:AutomationProperties.Name="{localization:UiText MenuOpenImageFile}"
                            automation:AutomationProperties.HelpText="{localization:UiText ToolbarOpenImageTooltip}"
                            Style="{StaticResource DockedToolbarButtonStyle}" />
                        <Button Content="{localization:UiText MenuOpenProjectOrSession}"
                            Click="OnToolbarFileCommandClick"
                            Tag="{x:Static controls:ImageViewerFileMenuTags.LoadSession}"
                            ToolTip="{localization:UiText MenuOpenProjectOrSession}"
                            automation:AutomationProperties.Name="{localization:UiText MenuOpenProjectOrSession}"
                            automation:AutomationProperties.HelpText="{localization:UiText MenuOpenProjectOrSession}"
                            Style="{StaticResource DockedToolbarButtonStyle}" />
                        <Button Content="{localization:UiText ToolbarSaveSession}"
                            Click="OnToolbarFileCommandClick"
                            Tag="{x:Static controls:ImageViewerFileMenuTags.SaveSession}"
                            ToolTip="{localization:UiText MenuSaveSession}"
                            automation:AutomationProperties.Name="{localization:UiText MenuSaveSession}"
                            automation:AutomationProperties.HelpText="{localization:UiText MenuSaveSession}"
                            IsEnabled="{Binding MenuState.File.SaveSessionEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource DockedToolbarButtonStyle}" />
                        <Button Content="{localization:UiText MenuFitToView}"
                            Click="OnToolbarViewCommandClick"
                            Tag="{x:Static controls:ImageViewerViewMenuTags.FitToView}"
                            ToolTip="{localization:UiText ToolbarFitToViewTooltip}"
                            automation:AutomationProperties.HelpText="{localization:UiText ToolbarFitToViewTooltip}"
                            Style="{StaticResource DockedToolbarButtonStyle}" />
                        <StackPanel x:Name="quickToolsPanel" Orientation="Horizontal" />
                        <Button Content="{localization:UiText ToolbarCalibrate}"
                            x:Name="toolbarCalibrateButton"
                            ToolTipService.ShowOnDisabled="True"
                            Click="OnRoiMenuCommandClick"
                            Tag="{x:Static controls:ImageViewerRoiMenuTags.CalibratePixels}"
                            automation:AutomationProperties.Name="{localization:UiText MenuCalibratePixels}"
                            automation:AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                            IsEnabled="{Binding MenuState.Context.CalibratePixelsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DockedToolbarButtonStyle}">
                                    <Setter Property="ToolTip" Value="{localization:UiText ToolbarCalibratePixelsTooltip}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="ToolTip" Value="{localization:UiText MenuNeedCalibrationLine}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{localization:UiText ToolbarExportCsv}"
                            Click="OnFeatureMenuCommandClick"
                            Tag="{x:Static controls:ImageViewerFeatureMenuTags.ExportAnalysisCsv}"
                            ToolTip="{localization:UiText MenuExportAnalysisCsv}"
                            automation:AutomationProperties.Name="{localization:UiText MenuExportAnalysisCsv}"
                            automation:AutomationProperties.HelpText="{localization:UiText MenuExportAnalysisCsv}"
                            IsEnabled="{Binding MenuState.Context.ExportAnalysisCsvEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource DockedToolbarButtonStyle}" />
                        <TextBlock x:Name="toolbarZoomLevel"
                               Margin="6,0,6,0"
                               Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding Scale, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:P0}}"
                               automation:AutomationProperties.Name="{localization:UiText ZoomLevelDisplayAccessibleName}"
                               ToolTip="{localization:UiText ToolbarZoomLevelTooltip}" />
                        <Button x:Name="toolbarHideButton" x:FieldModifier="internal"
                            Click="OnToolbarHideClick"
                            Content="&#x2212;"
                            ToolTip="{localization:UiText ToolbarHideHint}"
                            automation:AutomationProperties.Name="{localization:UiText ToolbarHideButton}"
                            Style="{StaticResource DockedToolbarButtonStyle}" />
                    </WrapPanel>
                </Border>
            </DockPanel>
        </Border>

        <Border x:Name="recoveryBanner" Grid.Row="1" Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="8,3"
                Padding="10,4"
                Background="{DynamicResource ViewerSurfaceBrush}"
                BorderBrush="{DynamicResource ViewerAccentBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding HasRecoverySnapshot, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                           Text="{localization:UiText RecoveryBannerText}"
                           automation:AutomationProperties.LiveSetting="Polite" />
                <Button Padding="10,4"
                        Content="{localization:UiText RecoveryRestoreButton}"
                        Click="OnRecoverAutoSaveClick"
                        Background="{DynamicResource ViewerAccentSoftBrush}"
                        BorderBrush="{DynamicResource ViewerAccentBorderBrush}"
                        Foreground="{DynamicResource ViewerTextPrimaryBrush}" />
                <Button Margin="6,0,0,0"
                        Padding="8,4"
                        Content="{localization:UiText RecoveryDismissButton}"
                        Click="OnDismissRecoveryClick"
                        Background="Transparent"
                        BorderBrush="{DynamicResource ViewerPanelBorderBrush}"
                        Foreground="{DynamicResource ViewerTextSecondaryBrush}" />
            </WrapPanel>
        </Border>

    <Grid Grid.Row="2" x:Name="rootGrid" Background="{DynamicResource ViewerBackdropBrush}" ClipToBounds="True" SnapsToDevicePixels="True" AllowDrop="True">
        <Grid.ContextMenu>
            <ContextMenu x:Name="mainContextMenu" x:FieldModifier="internal" Opened="OnContextMenuOpened" Closed="OnContextMenuClosed">
                <ContextMenu.Resources>
                    <controls:ImageViewerViewShortcutTextConverter x:Key="ViewShortcutText" />
                    <Style TargetType="ContextMenu">
                        <Setter Property="Background" Value="{DynamicResource ViewerMenuPopupBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ViewerMenuBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ContextMenu">
                                    <Border Background="{DynamicResource ViewerMenuPopupBrush}" BorderBrush="{DynamicResource ViewerMenuBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" SnapsToDevicePixels="True">
                                        <DockPanel LastChildFill="True">
                                            <!-- 搜索区固定挂在菜单模板顶部，而不是作为一个菜单项：
                                                 作为菜单项时会被自动生成的容器按内容宽度左对齐（HorizontalContentAlignment=Left），
                                                 导致搜索框塌成一个小方块、无法横贯菜单宽度。 -->
                                            <StackPanel DockPanel.Dock="Top">
                                                <TextBlock Margin="8,6,8,0"
                                                           Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                                                           FontSize="11"
                                                           Text="{localization:UiText MenuSearch}" />
                                                <TextBox x:Name="PART_MenuSearchBox"
                                                         Margin="4"
                                                         Padding="8,5"
                                                         HorizontalAlignment="Stretch"
                                                         Background="{DynamicResource ViewerSurfaceAltBrush}"
                                                         Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                                                         BorderBrush="{DynamicResource ViewerMenuBorderBrush}"
                                                         CaretBrush="{DynamicResource ViewerTextPrimaryBrush}"
                                                         SelectionBrush="{DynamicResource ViewerSelectionBrush}"
                                                         ToolTip="{localization:UiText MenuSearch}"
                                                         automation:AutomationProperties.Name="{localization:UiText MenuSearch}"
                                                         automation:AutomationProperties.HelpText="{localization:UiText MenuSearch}"
                                                         TextChanged="OnMenuSearchTextChanged"
                                                         PreviewKeyDown="OnMenuSearchPreviewKeyDown" />
                                                <TextBlock x:Name="PART_MenuSearchMatchCount"
                                                            Margin="12,4,12,2"
                                                            Foreground="{DynamicResource ViewerAccentBrush}"
                                                            Text="{localization:UiText MenuSearchMatchCount}"
                                                            automation:AutomationProperties.LiveSetting="Polite"
                                                            Visibility="Collapsed" />
                                                <TextBlock x:Name="PART_MenuSearchNoResults"
                                                            Margin="12,4,12,8"
                                                            Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                                                            Text="{localization:UiText MenuSearchNoResults}"
                                                            automation:AutomationProperties.LiveSetting="Polite"
                                                            Visibility="Collapsed" />
                                                <Separator />
                                            </StackPanel>
                                            <ItemsPresenter SnapsToDevicePixels="True" />
                                        </DockPanel>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="InputGestureText" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource ViewShortcutText}}" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Grid>
                                        <Border x:Name="menuItemBorder" Background="Transparent" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" x:Name="checkGlyph" Visibility="Collapsed"
                                                      Data="M 0,4 L 3.5,7.5 L 8,1" Stroke="{DynamicResource ViewerAccentBrush}" StrokeThickness="1.5"
                                                      Margin="10,0,4,0" VerticalAlignment="Center" Width="8" Height="9" />
                                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  RecognizesAccessKey="True" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" x:Name="shortcutText"
                                                           Text="{TemplateBinding InputGestureText}"
                                                           Foreground="{DynamicResource ViewerTextSecondaryBrush}" Margin="24,0,10,0"
                                                           VerticalAlignment="Center" FontSize="11" />
                                                <Path Grid.Column="3" x:Name="submenuArrow" Visibility="Collapsed"
                                                      Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource ViewerTextSecondaryBrush}" StrokeThickness="1.5"
                                                      Margin="0,0,10,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Popup x:Name="SubMenuPopup" AllowsTransparency="True"
                                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                               Placement="Right" VerticalOffset="-2" HorizontalOffset="-2"
                                               PopupAnimation="Slide" Focusable="False">
                                            <Border Background="{DynamicResource ViewerMenuPopupBrush}" BorderBrush="{DynamicResource ViewerMenuBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="menuItemBorder" Property="Background" Value="{DynamicResource ViewerButtonHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="menuItemBorder" Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource ViewerTextDisabledBrush}" />
                                            <Setter TargetName="shortcutText" Property="Foreground" Value="{DynamicResource ViewerTextMutedBrush}" />
                                            <Setter TargetName="submenuArrow" Property="Stroke" Value="{DynamicResource ViewerTextMutedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="True">
                                            <Setter TargetName="submenuArrow" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="shortcutText" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="Separator">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Separator">
                                    <Border Height="1" Background="{DynamicResource ViewerMenuBorderBrush}" Margin="8,3" SnapsToDevicePixels="True" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="{DynamicResource ViewerSurfaceAltBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ViewerMenuBorderBrush}" />
                        <Setter Property="CaretBrush" Value="{DynamicResource ViewerTextPrimaryBrush}" />
                        <Setter Property="SelectionBrush" Value="{DynamicResource ViewerSelectionBrush}" />
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="{Binding DataContext.ImageLoadStatusText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Click="OnRetryImageLoadClick"
                          IsEnabled="{Binding DataContext.CanRetryImageLoad, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          ToolTip="{localization:UiText ImageLoadRetry}"
                          Foreground="{DynamicResource ViewerErrorBrush}"
                          Visibility="{Binding DataContext.ImageLoadHasError, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Separator Visibility="{Binding DataContext.ImageLoadHasError, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <MenuItem x:Name="openImageMenuItem" x:FieldModifier="internal" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.OpenImage}" Header="{localization:UiText MenuOpenImageFile}" InputGestureText="Ctrl+O" />
                <MenuItem x:Name="saveSessionMenuItem" x:FieldModifier="internal" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.SaveSession}" Header="{localization:UiText MenuSaveSession}" InputGestureText="Ctrl+S" IsEnabled="{Binding MenuState.File.SaveSessionEnabled}" />
                <Separator />
                <MenuItem x:Name="undoMenuItem" x:FieldModifier="internal" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.Undo}" Header="{localization:UiText MenuUndo}" InputGestureText="Ctrl+Z" IsEnabled="{Binding MenuState.Context.UndoEnabled}" />
                <MenuItem x:Name="redoMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.Redo}" Header="{localization:UiText MenuRedo}" InputGestureText="Ctrl+Y" IsEnabled="{Binding MenuState.Context.RedoEnabled}" />
                <Separator />
                <MenuItem x:Name="fitToViewMenuItem" x:FieldModifier="internal" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.FitToView}" Header="{localization:UiText MenuFitToView}" IsEnabled="{Binding MenuState.View.FitToViewEnabled}" />
                <MenuItem x:Name="fillToViewMenuItem" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.FillToView}" Header="{localization:UiText MenuFillToView}" IsEnabled="{Binding MenuState.View.FitToViewEnabled}" />
                <MenuItem x:Name="actualSizeMenuItem" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ActualSize}" Header="{localization:UiText MenuActualSize}" IsEnabled="{Binding MenuState.View.ActualSizeEnabled}" />
                <MenuItem x:Name="resetViewMenuItem" x:FieldModifier="internal" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ResetView}" Header="{localization:UiText MenuResetView}" IsEnabled="{Binding MenuState.View.ResetViewEnabled}" />
                <MenuItem x:Name="editPropertiesMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.EditProperties}" Header="{localization:UiText MenuEditProperties}" IsEnabled="{Binding MenuState.Context.EditPropertiesEnabled}" Visibility="{Binding MenuState.Context.EditPropertiesEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <MenuItem x:Name="contextRoiShortcutsMenuItem" Header="{localization:UiText MenuSelectedObjectShortcuts}">
                    <MenuItem x:Name="setLabelMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetLabel}" Header="{localization:UiText MenuSetLabel}" IsEnabled="{Binding MenuState.Context.SetLabelEnabled}" Visibility="{Binding MenuState.Context.SetLabelEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <MenuItem x:Name="setColorMenuItem" Header="{localization:UiText MenuSetColor}" IsEnabled="{Binding MenuState.Context.SetColorEnabled}" Visibility="{Binding MenuState.Context.SetColorEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorCyanDefault}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorCyan}" />
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorRed}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorRed}" />
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorGreen}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorGreen}" />
