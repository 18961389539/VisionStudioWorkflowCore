    },
    {
      "id": "c2",
      "sourceNodeId": "threshold-1",
      "sourcePort": "next",
      "targetNodeId": "blob-1",
      "targetPort": "exec",
      "kind": "control"
    },
    {
      "id": "d2",
      "sourceNodeId": "threshold-1",
      "sourcePort": "image",
      "targetNodeId": "blob-1",
      "targetPort": "image",
      "kind": "data"
    }
  ]
