        "x": 60,
        "y": 150
      },
      "parameters": {
        "cameraId": "virtual-1",
        "timeoutMs": 1500,
        "frameMode": "Latest",
        "autoStart": true
      }
    },
    {
      "id": "threshold-1",
      "type": "image.threshold",
      "name": "Threshold",
      "position": {
        "x": 380,
        "y": 150
      },
      "parameters": {
        "threshold": 150
      }
    },
    {
      "id": "blob-1",
      "type": "measure.blob",
      "name": "Largest Blob",
      "position": {
        "x": 700,
        "y": 150
      },
      "parameters": {
        "minArea": 1000
      }
    }
