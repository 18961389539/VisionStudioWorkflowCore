<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- 帧语义与目录契约测试需要直接读取内部坐标帧，避免只通过错误消息间接断言。 -->
    <InternalsVisibleTo Include="VisionStudio.Engine.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VisionStudio.Abstractions\VisionStudio.Abstractions.csproj" />
    <!-- 相机/溯源契约（ICameraDevice、VisionFrame、HardwareProvenanceData）住在契约程序集，
         厂商适配器与我方实现共同引用它，避免适配器被迫依赖整个引擎。 -->
    <ProjectReference Include="..\VisionStudio.Hardware.Abstractions\VisionStudio.Hardware.Abstractions.csproj" />
    <!-- 图像基础类型与算法内核下沉为独立程序集：引擎引用它们，它们不引用引擎。
         这条单向边由 Engine.Tests/Contracts/AssemblyBoundaryTests 守护。 -->
    <ProjectReference Include="..\VisionStudio.Imaging\VisionStudio.Imaging.csproj" />
    <ProjectReference Include="..\VisionStudio.Algorithms\VisionStudio.Algorithms.csproj" />
    <ProjectReference Include="..\VisionStudio.Scripting\VisionStudio.Scripting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp5.Windows" />
    <PackageReference Include="JLVisionLib" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="System.Numerics.Tensors" />
    <PackageReference Include="WorkflowCore" />
    <PackageReference Include="WorkflowCore.DSL" />
    <PackageReference Include="NModbus" />
    <PackageReference Include="S7netplus" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- 串口私有协议（光源控制器/扫码枪/拧紧枪）：System.IO.Ports 8.0.0 已在本地缓存，离线可还原。 -->
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="ZXing.Net" />
    <PackageReference Include="TesseractOCR" />
  </ItemGroup>
</Project>
