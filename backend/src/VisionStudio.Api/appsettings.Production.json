{
  "VisionStudio": {
    "RuntimeOnly": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "TraceRetention": {
    "MetadataRetentionDays": 3650,
    "OkArtifactRetentionDays": 7,
    "NgArtifactRetentionDays": 90,
    "ErrorArtifactRetentionDays": 90,
    "ReviewArtifactRetentionDays": 30,
    "OkPreviewSampleEvery": 20,
    "CleanupIntervalMinutes": 60,
    "OkReplaySampleEvery": 20
  },
  "Security": {
    "Enabled": true,
    "AutoLoginAdmin": false
  },
  "Storage": {
    "WarningFreeBytes": 2147483648,
    "CriticalFreeBytes": 536870912,
    "MaxArtifactBytes": 21474836480,
    "MaxBackupBytes": 10737418240,
    "BackupRetentionCount": 10,
    "MonitorIntervalSeconds": 30,
    "AutoCleanupOnCritical": true,
    "IncludeArtifactsInBackup": true
  },
  "VendorProvenance": {
    "CacheSeconds": 30,
    "Basler": [],
    "Hikrobot": [],
    "AbbRws": []
  },
  "CameraAdapters": {
    "BaslerAssemblyPath": null,
    "HikrobotAssemblyPath": null,
    "Cameras": []
  },
  "PluginPackages": {
    "RequireTrustedSignature": true,
    "MaxPackageBytes": 268435456,
    "MaxExpandedBytes": 805306368,
    "MaxEntries": 4096
  }
}
