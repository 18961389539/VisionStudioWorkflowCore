<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VisionStudio.Engine\VisionStudio.Engine.csproj" />
    <ProjectReference Include="..\VisionStudio.Camera.Basler\VisionStudio.Camera.Basler.csproj" />
    <ProjectReference Include="..\VisionStudio.Camera.Hikrobot\VisionStudio.Camera.Hikrobot.csproj" />
    <ProjectReference Include="..\VisionStudio.Plugin.Worker\VisionStudio.Plugin.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="McMaster.NETCore.Plugins" Version="2.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <Target Name="CopyPluginWorkerForBuild" AfterTargets="Build">
    <ItemGroup>
      <_PluginWorkerBuildFiles Include="..\VisionStudio.Plugin.Worker\bin\$(Configuration)\net10.0\VisionStudio.Plugin.Worker.dll" />
      <_PluginWorkerBuildFiles Include="..\VisionStudio.Plugin.Worker\bin\$(Configuration)\net10.0\VisionStudio.Plugin.Worker.deps.json" />
      <_PluginWorkerBuildFiles Include="..\VisionStudio.Plugin.Worker\bin\$(Configuration)\net10.0\VisionStudio.Plugin.Worker.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginWorkerBuildFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
  </Target>
  <Target Name="PublishPluginWorker" AfterTargets="Publish">
    <MSBuild Projects="..\VisionStudio.Plugin.Worker\VisionStudio.Plugin.Worker.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(PublishDir)" />
  </Target>
</Project>
