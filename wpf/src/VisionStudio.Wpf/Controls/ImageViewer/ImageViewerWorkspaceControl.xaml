<UserControl x:Class="VisionStudio.Wpf.Controls.ImageViewer.ImageViewerWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="680"
             Background="#11161D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏（WrapPanel 避免窄栏裁剪） -->
        <Border Grid.Row="0" Background="#161D27" BorderBrush="#293548" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="ViewerEngineBadge" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="#64748B" FontSize="11" Margin="8,0,0,0" />
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FitButton" Content="适配窗口" Click="OnFitClick" Padding="9,4" Margin="0,2,5,2"
                            Background="#212B38" Foreground="#E2E8F0" BorderBrush="#334155" />
                    <Button x:Name="ActualSizeButton" Content="1:1 原图" Click="OnActualSizeClick" Padding="9,4" Margin="0,2,5,2"
                            Background="#212B38" Foreground="#E2E8F0" BorderBrush="#334155" />
                    <Button x:Name="ZoomInButton" Content="放大" Click="OnZoomInClick" Padding="8,4" Margin="0,2,4,2"
                            Background="#212B38" Foreground="#E2E8F0" BorderBrush="#334155" />
                    <Button x:Name="ZoomOutButton" Content="缩小" Click="OnZoomOutClick" Padding="8,4" Margin="0,2,8,2"
                            Background="#212B38" Foreground="#E2E8F0" BorderBrush="#334155" />
                    <CheckBox x:Name="ShowOverlaysCheckBox" Content="显示标注叠加" IsChecked="True"
                              Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,2,10,2"
                              Checked="OnOverlayVisibilityChanged" Unchecked="OnOverlayVisibilityChanged" />
                    <Button x:Name="DrawRectRoiButton" Content="框选ROI" Click="OnDrawRectRoiClick" Padding="8,4" Margin="0,2,4,2"
                            Background="#1B2533" Foreground="#93C5FD" BorderBrush="#334155"
                            ToolTip="在图像上拖拽绘制矩形 ROI（供节点参数导入）" />
                    <Button x:Name="DrawCircleRoiButton" Content="圆ROI" Click="OnDrawCircleRoiClick" Padding="8,4" Margin="0,2,4,2"
                            Background="#1B2533" Foreground="#93C5FD" BorderBrush="#334155"
                            ToolTip="在图像上拖拽绘制圆形 ROI" />
                    <Button x:Name="DrawPolygonRoiButton" Content="多边形ROI" Click="OnDrawPolygonRoiClick" Padding="8,4" Margin="0,2,4,2"
                            Background="#1B2533" Foreground="#93C5FD" BorderBrush="#334155"
                            ToolTip="在图像上逐点绘制多边形 ROI（右键/双击闭合）" />
                    <Button x:Name="ClearUserRoisButton" Content="清用户ROI" Click="OnClearUserRoisClick" Padding="8,4" Margin="0,2,8,2"
                            Background="#1B2533" Foreground="#FCA5A5" BorderBrush="#334155"
                            ToolTip="清空用户绘制的 ROI（保留算法标注）" />
                    <Button Content="打开本地图像" Click="OnOpenLocalImageClick" Padding="9,4" Margin="0,2,0,2"
                            Background="#1E3A5F" Foreground="#E2E8F0" BorderBrush="#3B82F6" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 中央图像渲染区（外部 ImageViewerControl 宿主或内建高精度缩放画布） -->
        <Grid x:Name="ViewportHostGrid" Grid.Row="1" ClipToBounds="True" Background="#0D1117"
              MouseWheel="OnViewportMouseWheel"
              MouseLeftButtonDown="OnViewportMouseDown"
              MouseMove="OnViewportMouseMove"
              MouseLeftButtonUp="OnViewportMouseUp">
            <Canvas x:Name="TransformSurface">
                <Grid x:Name="ImageLayerRoot" RenderTransformOrigin="0,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="PanTransform" X="0" Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Image x:Name="DisplayImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
                </Grid>
            </Canvas>

            <!-- 空状态提示 -->
            <Border x:Name="EmptyPlaceholder" Background="#161D27" CornerRadius="8" Padding="24,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#2D3748" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="暂无图像输出" Foreground="#E2E8F0" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="运行工作流、双击查看节点输出或从左侧工具栏打开本地图像" Foreground="#94A3B8"
                               FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部像素与缩放状态栏 -->
        <Border Grid.Row="2" Background="#161C24" BorderBrush="#2D3748" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="ImageCaptionText" Text="未加载图像" Foreground="#CBD5E1" FontSize="12" DockPanel.Dock="Left" />
                <TextBlock x:Name="ZoomText" Text="100%" Foreground="#93C5FD" FontSize="12" DockPanel.Dock="Right" Margin="14,0,0,0" />
                <TextBlock x:Name="PixelInfoText" Text="-" Foreground="#94A3B8" FontSize="12" DockPanel.Dock="Right" Margin="14,0,0,0" />
                <TextBlock x:Name="OverlayCountText" Text="标注: 0" Foreground="#86EFAC" FontSize="12" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
