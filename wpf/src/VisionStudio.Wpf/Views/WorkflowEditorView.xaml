<UserControl x:Class="VisionStudio.Wpf.Views.WorkflowEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:vm="clr-namespace:VisionStudio.Wpf.ViewModels"
             xmlns:themes="clr-namespace:VisionStudio.Wpf.Themes"
             xmlns:img="clr-namespace:VisionStudio.Wpf.Controls.ImageViewer"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1360"
             Background="#0F141B">
    <UserControl.Resources>
        <DrawingBrush x:Key="EditorGridBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#1B2534">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,12" RadiusX="1.1" RadiusY="1.1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部流程工具栏（双行紧凑分组） -->
        <Border Grid.Row="0" Background="#161D27" BorderBrush="#293548" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel>
                <!-- 第一行：流程文档与画布编辑 -->
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="流程" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,1,5,1" FontSize="11.5" />
                    <TextBox Text="{Binding WorkflowName, UpdateSourceTrigger=PropertyChanged}" Width="155"
                             IsEnabled="{Binding CanEdit}" Margin="0,1,6,1" Padding="7,3.5" FontSize="11.5"
                             themes:TextBoxHelper.Placeholder="输入流程名称" />

                    <ComboBox ItemsSource="{Binding AvailableWorkflows}"
                              SelectedItem="{Binding SelectedWorkflowChoice}"
                              DisplayMemberPath="DisplayName"
                              Width="185" Margin="0,1,5,1" Padding="7,3.5" FontSize="11.5" />
                    <Button Content="打开" Command="{Binding LoadSelectedWorkflowCommand}" Style="{StaticResource CompactToolbarButtonStyle}" />
                    <Button Content="新建" Command="{Binding NewWorkflowCommand}" Style="{StaticResource CompactToolbarButtonStyle}" />
                    <Button Content="保存" Command="{Binding SaveWorkflowCommand}" Style="{StaticResource CompactToolbarButtonStyle}" />
                    <Button Content="另存为" Command="{Binding SaveAsWorkflowCommand}" Style="{StaticResource CompactToolbarButtonStyle}" />
                    <Button Content="删流程" Command="{Binding DeleteSavedWorkflowCommand}" Style="{StaticResource CompactToolbarButtonStyle}" Foreground="#FCA5A5" />
                    <Button Content="导入" Command="{Binding ImportWorkflowCommand}" Style="{StaticResource CompactToolbarButtonStyle}" />
                    <Button Content="导出" Command="{Binding ExportWorkflowCommand}" Style="{StaticResource CompactToolbarButtonStyle}" />

                    <Rectangle Width="1" Height="18" Fill="#293548" Margin="3,1,6,1" VerticalAlignment="Center" />

                    <Button Content="撤销" Command="{Binding UndoCommand}" Style="{StaticResource CompactToolbarButtonStyle}" ToolTip="撤销上一步画布修改 (Ctrl+Z)" />
                    <Button Content="重做" Command="{Binding RedoCommand}" Style="{StaticResource CompactToolbarButtonStyle}" ToolTip="重做 (Ctrl+Y)" />
                    <Button Content="复制" Command="{Binding CopySelectedNodesCommand}" Style="{StaticResource CompactToolbarButtonStyle}" ToolTip="复制选中节点 (Ctrl+C)" />
                    <Button Content="粘贴" Command="{Binding PasteNodesCommand}" Style="{StaticResource CompactToolbarButtonStyle}" ToolTip="粘贴节点 (Ctrl+V)" />
                    <Button Content="自动排版" Command="{Binding AutoLayoutCommand}" Style="{StaticResource CompactToolbarButtonStyle}" />
                </WrapPanel>

                <!-- 第二行：校验、执行、断点调试与视口控制 -->
                <WrapPanel VerticalAlignment="Center" Margin="0,3,0,0">
                    <Button Content="编译校验" Command="{Binding ValidateWorkflowCommand}" Style="{StaticResource CompactToolbarButtonStyle}" />
                    <Button Content="运行流程" Command="{Binding RunWorkflowCommand}"
                            Style="{StaticResource SuccessButtonStyle}" Padding="11,4" FontSize="11.5" Margin="0,1,4,1" />
                    <Button Content="运行至节点" Command="{Binding RunToSelectedNodeCommand}" Style="{StaticResource CompactToolbarButtonStyle}"
                            Foreground="#93C5FD" ToolTip="执行到当前选中节点 (F10)" />
                    <Button Content="断点" Command="{Binding ToggleBreakpointCommand}" Style="{StaticResource CompactToolbarButtonStyle}"
                            Foreground="#FCA5A5" ToolTip="切换选中节点断点 (F9)" />
                    <Button Content="断点调试/继续" Command="{Binding StartOrContinueDebugCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            Padding="9,4" FontSize="11.5" Margin="0,1,4,1" />
                    <Button Content="缓存单步" Command="{Binding RunCachedDebugNodeCommand}"
                            Visibility="{Binding HasActiveDebugSession, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource CompactToolbarButtonStyle}" Background="#4338CA" BorderBrush="#6366F1"
                            ToolTip="使用缓存的上游输入仅重跑当前选中节点" />
                    <Button Content="结束调试" Command="{Binding StopDebugSessionCommand}"
                            Visibility="{Binding HasActiveDebugSession, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource CompactToolbarButtonStyle}" Foreground="#FCD34D" />
                    <Button Content="停止" Command="{Binding CancelRunCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource DangerButtonStyle}" Padding="10,4" FontSize="11.5" Margin="0,1,4,1" />

                    <Rectangle Width="1" Height="18" Fill="#293548" Margin="3,1,6,1" VerticalAlignment="Center" />

                    <Button Content="节点详情" Command="{Binding OpenNodeDetailCommand}" Style="{StaticResource CompactToolbarButtonStyle}" />
                    <Button Content="删除节点" Command="{Binding DeleteSelectedNodesCommand}" Style="{StaticResource CompactToolbarButtonStyle}" />
                    <Button Content="适配画布" Click="OnFitGraphClick" Style="{StaticResource CompactToolbarButtonStyle}" />
                    <Button x:Name="ShortcutsHelpButton" Content="? 快捷键" Click="OnToggleShortcutsHelpClick"
                            Style="{StaticResource CompactToolbarButtonStyle}" Foreground="#93C5FD" />
                    <Popup x:Name="ShortcutsHelpPopup"
                           PlacementTarget="{Binding ElementName=ShortcutsHelpButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#161D27" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="流程编辑器快捷键与画布操作" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                <TextBlock Foreground="#CBD5E1" FontSize="11.5" LineHeight="19">
                                    <Run Text="Ctrl+S" Foreground="#93C5FD" FontWeight="SemiBold" /><Run Text=" 保存   ·   " />
                                    <Run Text="Ctrl+N" Foreground="#93C5FD" FontWeight="SemiBold" /><Run Text=" 新建   ·   " />
                                    <Run Text="F5" Foreground="#93C5FD" FontWeight="SemiBold" /><Run Text=" 运行   ·   " />
                                    <Run Text="Esc" Foreground="#93C5FD" FontWeight="SemiBold" /><Run Text=" 停止" />
                                    <LineBreak />
                                    <Run Text="Ctrl+Z / Ctrl+Y" Foreground="#93C5FD" FontWeight="SemiBold" /><Run Text=" 撤销 / 重做   ·   " />
                                    <Run Text="Ctrl+C / Ctrl+V / Ctrl+D" Foreground="#93C5FD" FontWeight="SemiBold" /><Run Text=" 复制 / 粘贴 / 创建副本" />
                                    <LineBreak />
                                    <Run Text="F9" Foreground="#93C5FD" FontWeight="SemiBold" /><Run Text=" 切换断点   ·   " />
                                    <Run Text="F10" Foreground="#93C5FD" FontWeight="SemiBold" /><Run Text=" 运行至此节点   ·   " />
                                    <Run Text="Del" Foreground="#93C5FD" FontWeight="SemiBold" /><Run Text=" 删除选中节点" />
                                    <LineBreak />
                                    <Run Text="滚轮" Foreground="#86EFAC" FontWeight="SemiBold" /><Run Text=" 缩放画布   ·   " />
                                    <Run Text="双击节点" Foreground="#86EFAC" FontWeight="SemiBold" /><Run Text=" 编辑参数   ·   " />
                                    <Run Text="右键画布/节点" Foreground="#86EFAC" FontWeight="SemiBold" /><Run Text=" 上下文菜单" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>
                </WrapPanel>

                <!-- 运行摘要 / 调试状态 / 未保存标识 -->
                <WrapPanel Margin="0,4,0,0" VerticalAlignment="Center">
                    <Border Background="{Binding LastRunStateKey, Converter={StaticResource StatusBgBrush}}"
                            CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock Text="{Binding LastRunSummary}"
                                   Foreground="{Binding LastRunStateKey, Converter={StaticResource StatusFgBrush}}"
                                   FontSize="11.5" FontWeight="Medium" TextWrapping="Wrap" />
                    </Border>
                    <Border Background="#422B0F" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4"
                            Padding="7,2" Margin="0,0,8,0"
                            Visibility="{Binding HasActiveDebugSession, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DebugSessionStatusText}" Foreground="#FCD34D" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#422B0F" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4"
                            Padding="7,2" Margin="0,0,8,0"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="有未保存的修改" Foreground="#FCD34D" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center">
                        <Run Text="节点 " /><Run Text="{Binding Nodes.Count, Mode=OneWay}" Foreground="#94A3B8" />
                        <Run Text="  ·  连线 " /><Run Text="{Binding Connections.Count, Mode=OneWay}" Foreground="#94A3B8" />
                    </TextBlock>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 主体三栏：左侧节点工具箱 | 中间 Nodify 画布 + 底部报告 | 右侧图像浏览区 -->
        <ScrollViewer Grid.Row="1" x:Name="EditorBodyScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid Width="{Binding ActualWidth, ElementName=EditorBodyScroll}" MinWidth="880">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="175" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="360" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- 左侧节点工具箱 -->
            <Border Grid.Column="0" Background="#141A22" BorderBrush="#293548" BorderThickness="0,0,1,0"
                    IsEnabled="{Binding CanEdit}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,9" Background="#161D27" BorderBrush="#243042" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="双击 / 拖拽" Foreground="#64748B" FontSize="10.5" VerticalAlignment="Center" />
                                <TextBlock Text="算子与节点工具箱" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="13" />
                            </DockPanel>
                            <Grid Margin="0,8,0,0">
                                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,5,26,5"
                                         themes:TextBoxHelper.Placeholder="搜索名称、类型或分类"
                                         ToolTip="输入中文名称或节点类型（如：阈值、找圆、match.shape）" />
                                <Button Content="×" Command="{Binding ClearSearchCommand}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,4,0" Padding="5,1"
                                        Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                        Visibility="{Binding SearchKeyword, Converter={StaticResource NotEmptyToVis}}"
                                        ToolTip="清空搜索" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                        <ItemsControl ItemsSource="{Binding FilteredToolbox}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Foreground="#93C5FD" Margin="0,2">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CategoryZh}" Foreground="#93C5FD" FontWeight="SemiBold" FontSize="12" />
                                                <Border Background="#1E293B" CornerRadius="8" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Items.Count}" Foreground="#94A3B8" FontSize="10.5" />
                                                </Border>
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="6,2,2,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="5" Padding="8,6" Margin="0,2" Cursor="Hand"
                                                            BorderThickness="1"
                                                            PreviewMouseLeftButtonDown="OnToolboxItemPreviewMouseDown"
                                                            PreviewMouseMove="OnToolboxItemPreviewMouseMove"
                                                            MouseLeftButtonDown="OnToolboxItemMouseDown"
                                                            ToolTip="{Binding Description}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1B222C" />
                                                                <Setter Property="BorderBrush" Value="#2A3444" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#232D3B" />
                                                                        <Setter Property="BorderBrush" Value="#3B82F6" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="+" Foreground="#60A5FA"
                                                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="#E2E8F0" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Type}" Foreground="#64748B" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <!-- 中间画布 + 底部节点执行报告 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="175" MinHeight="100" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#0B1017">
                    <nodify:NodifyEditor x:Name="GraphEditor"
                                         IsEnabled="{Binding CanEdit}"
                                         Background="{StaticResource EditorGridBrush}"
                                         GridCellSize="16"
                                         AllowDrop="True"
                                         DragOver="OnGraphDragOver"
                                         Drop="OnGraphDrop"
                                         PreviewKeyDown="OnGraphPreviewKeyDown"
                                         ItemsSource="{Binding Nodes}"
                                         Connections="{Binding Connections}"
                                         SelectedItem="{Binding SelectedNode}"
                                         SelectedItems="{Binding SelectedNodes}"
                                         PendingConnection="{Binding PendingConnection}"
                                         DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}">
                        <nodify:NodifyEditor.InputBindings>
                            <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
                            <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
                            <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
                            <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedNodesCommand}" />
                            <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteNodesCommand}" />
                            <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateSelectedNodesCommand}" />
                            <KeyBinding Key="Delete" Command="{Binding DeleteSelectedNodesCommand}" />
                            <KeyBinding Key="F9" Command="{Binding ToggleBreakpointCommand}" />
                            <KeyBinding Key="F10" Command="{Binding RunToSelectedNodeCommand}" />
                        </nodify:NodifyEditor.InputBindings>
                        <nodify:NodifyEditor.Resources>
                            <Style TargetType="{x:Type nodify:ItemContainer}" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                                <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                            </Style>
                        </nodify:NodifyEditor.Resources>

                        <nodify:NodifyEditor.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="粘贴节点" InputGestureText="Ctrl+V" Command="{Binding PasteNodesCommand}" />
                                <MenuItem Header="自动排版" Command="{Binding AutoLayoutCommand}" />
                                <Separator Style="{StaticResource DarkMenuSeparatorStyle}" />
                                <MenuItem Header="适配全部节点" Click="OnFitGraphClick" />
                                <MenuItem Header="重置视口 (1:1)" Click="OnResetViewportClick" />
                                <Separator Style="{StaticResource DarkMenuSeparatorStyle}" />
                                <MenuItem Header="编译校验" Command="{Binding ValidateWorkflowCommand}" />
                                <MenuItem Header="运行流程" InputGestureText="F5" Command="{Binding RunWorkflowCommand}" />
                            </ContextMenu>
                        </nodify:NodifyEditor.ContextMenu>

                        <nodify:NodifyEditor.ConnectionTemplate>
                            <DataTemplate DataType="{x:Type vm:WorkflowConnectionViewModel}">
                                <nodify:Connection Source="{Binding Source.Anchor}"
                                                   Target="{Binding Target.Anchor}"
                                                   StrokeThickness="2">
                                    <nodify:Connection.Style>
                                        <Style TargetType="nodify:Connection" BasedOn="{StaticResource {x:Type nodify:Connection}}">
                                            <Setter Property="Stroke" Value="#38BDF8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsControl}" Value="True">
                                                    <Setter Property="Stroke" Value="#F59E0B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </nodify:Connection.Style>
                                </nodify:Connection>
                            </DataTemplate>
                        </nodify:NodifyEditor.ConnectionTemplate>

                        <nodify:NodifyEditor.PendingConnectionTemplate>
                            <DataTemplate DataType="{x:Type vm:PendingConnectionViewModel}">
                                <nodify:PendingConnection AllowOnlyConnectors="True"
                                                          StartedCommand="{Binding StartCommand}"
                                                          CompletedCommand="{Binding FinishCommand}"
                                                          Stroke="#60A5FA" StrokeThickness="2" />
                            </DataTemplate>
                        </nodify:NodifyEditor.PendingConnectionTemplate>

                        <!-- 精简节点模板：断点指示、选中高亮、状态边框、成熟度标识、右键菜单与分色端口 -->
                        <nodify:NodifyEditor.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorkflowNodeViewModel}">
                                <nodify:Node Input="{Binding Inputs}" Output="{Binding Outputs}"
                                             MouseDoubleClick="OnNodeDoubleClick"
                                             PreviewMouseRightButtonDown="OnNodePreviewRightMouseDown"
                                             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                                             MinWidth="182" MaxWidth="245"
                                             Background="#1B222C">
                                    <nodify:Node.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="打开参数与详情" InputGestureText="双击"
                                                      Command="{Binding PlacementTarget.Tag.OpenNodeDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="切换断点" InputGestureText="F9"
                                                      Command="{Binding PlacementTarget.Tag.ToggleBreakpointCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="运行至此节点" InputGestureText="F10"
                                                      Command="{Binding PlacementTarget.Tag.RunToSelectedNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator Style="{StaticResource DarkMenuSeparatorStyle}" />
                                            <MenuItem Header="复制节点" InputGestureText="Ctrl+C"
                                                      Command="{Binding PlacementTarget.Tag.CopySelectedNodesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="创建副本" InputGestureText="Ctrl+D"
                                                      Command="{Binding PlacementTarget.Tag.DuplicateSelectedNodesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="删除节点" InputGestureText="Del" Foreground="#FCA5A5"
                                                      Command="{Binding PlacementTarget.Tag.DeleteSelectedNodesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </nodify:Node.ContextMenu>
                                    <nodify:Node.Style>
                                        <Style TargetType="nodify:Node" BasedOn="{StaticResource {x:Type nodify:Node}}">
                                            <Setter Property="BorderBrush" Value="#334155" />
                                            <Setter Property="BorderThickness" Value="1.2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExecutionState}" Value="Running">
                                                    <Setter Property="BorderBrush" Value="#3B82F6" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionState}" Value="Paused">
                                                    <Setter Property="BorderBrush" Value="#F59E0B" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionState}" Value="Succeeded">
                                                    <Setter Property="BorderBrush" Value="#22C55E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionState}" Value="Failed">
                                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=nodify:ItemContainer}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </nodify:Node.Style>

                                    <nodify:Node.Header>
                                        <StackPanel Margin="2,1">
                                            <DockPanel LastChildFill="True">
                                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="#EF4444" Margin="0,0,5,0"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding HasBreakpoint, Converter={StaticResource BoolToVis}}"
                                                         ToolTip="已设置断点 (F9)" />
                                                <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#2B3544" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ExecutionState}" Value="Running">
                                                                    <Setter Property="Background" Value="#2563EB" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ExecutionState}" Value="Paused">
                                                                    <Setter Property="Background" Value="#D97706" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ExecutionState}" Value="Succeeded">
                                                                    <Setter Property="Background" Value="#15803D" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ExecutionState}" Value="Failed">
                                                                    <Setter Property="Background" Value="#B91C1C" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusBadgeText}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <Border DockPanel.Dock="Right" Background="#78350F" BorderBrush="#F59E0B" BorderThickness="1"
                                                        CornerRadius="3" Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsNonStableMaturity, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding MaturityBadge}" Foreground="#FDE68A" FontSize="9.5" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontSize="12"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="双击打开节点参数与输出详情" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Type}" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </nodify:Node.Header>

                                    <nodify:Node.InputConnectorTemplate>
                                        <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                            <nodify:NodeInput Header="{Binding Title}"
                                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                              IsConnected="{Binding IsConnected}"
                                                              BorderBrush="{Binding DataType, Converter={StaticResource PortTypeBrush}}"
                                                              ToolTip="{Binding TooltipText}"
                                                              Foreground="#CBD5E1" FontSize="11" />
                                        </DataTemplate>
                                    </nodify:Node.InputConnectorTemplate>

                                    <nodify:Node.OutputConnectorTemplate>
                                        <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                            <nodify:NodeOutput Header="{Binding Title}"
                                                               Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                               IsConnected="{Binding IsConnected}"
                                                               BorderBrush="{Binding DataType, Converter={StaticResource PortTypeBrush}}"
                                                               ToolTip="{Binding TooltipText}"
                                                               Foreground="#CBD5E1" FontSize="11" />
                                        </DataTemplate>
                                    </nodify:Node.OutputConnectorTemplate>
                                </nodify:Node>
                            </DataTemplate>
                        </nodify:NodifyEditor.ItemTemplate>
                    </nodify:NodifyEditor>

                    <!-- 空画布引导提示 -->
                    <Border Background="#161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="8"
                            Padding="22,16" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding Nodes.Count, Converter={StaticResource ZeroToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="当前画布为空" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="从左侧工具箱双击或拖拽算子到此处，或从顶部选择已有流程打开"
                                       Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 右上角画布缩放悬浮条 -->
                    <Border Background="#CC161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="6"
                            Padding="4,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="−" Click="OnZoomOutGraphClick" Padding="7,2" Margin="0,0,3,0" ToolTip="缩小画布" />
                            <TextBlock Text="{Binding ViewportZoom, ElementName=GraphEditor, StringFormat={}{0:P0}}"
                                       Foreground="#93C5FD" FontSize="11" VerticalAlignment="Center" Margin="4,0" MinWidth="36" TextAlignment="Center" />
                            <Button Content="+" Click="OnZoomInGraphClick" Padding="7,2" Margin="0,0,4,0" ToolTip="放大画布" />
                            <Button Content="适配" Click="OnFitGraphClick" Padding="8,2" Margin="0,0,3,0" ToolTip="适配全部节点到视口" />
                            <Button Content="1:1" Click="OnResetViewportClick" Padding="7,2" ToolTip="重置画布缩放与原点" />
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />

                <!-- 底部节点执行摘要与校验问题 -->
                <TabControl Grid.Row="2" Background="#141A22" BorderBrush="#293548" BorderThickness="0,1,0,0">
                    <TabItem Header="最近执行节点报告">
                        <DataGrid ItemsSource="{Binding LatestNodeReports}" AutoGenerateColumns="False" IsReadOnly="True"
                                  MouseDoubleClick="OnReportRowDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding ExecutionSequence}" Width="55" />
                                <DataGridTextColumn Header="节点 ID" Binding="{Binding NodeId}" Width="130" />
                                <DataGridTextColumn Header="类型" Binding="{Binding NodeType}" Width="170" />
                                <DataGridTemplateColumn Header="状态" Width="74">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Success, Converter={StaticResource StatusBgBrush}}"
                                                    CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Success, Converter={StaticResource StatusFgBrush}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="失败" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Success}" Value="True">
                                                                    <Setter Property="Text" Value="成功" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="耗时 (ms)" Binding="{Binding DurationMs, StringFormat=F2}" Width="90" />
                                <DataGridTextColumn Header="错误信息" Binding="{Binding Error}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="校验与成熟度问题">
                        <DataGrid ItemsSource="{Binding ValidationIssues}" AutoGenerateColumns="False" IsReadOnly="True"
                                  MouseDoubleClick="OnValidationIssueDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="级别" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Severity, Converter={StaticResource StatusBgBrush}}"
                                                    CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Severity}"
                                                           Foreground="{Binding Severity, Converter={StaticResource StatusFgBrush}}"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="节点 ID" Binding="{Binding NodeId}" Width="140" />
                                <DataGridTextColumn Header="说明（双击定位节点）" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" />

            <!-- 右侧图像浏览工作区 -->
            <DockPanel Grid.Column="4" Background="#11161D">
                <Border DockPanel.Dock="Top" Background="#161D27" BorderBrush="#293548" BorderThickness="0,0,0,1" Padding="10,7">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Foreground="#94A3B8" FontSize="11">
                                <Run Text="{Binding NodeImageChoices.Count, Mode=OneWay}" /><Run Text=" 帧" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="中间图像：" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                        <ComboBox ItemsSource="{Binding NodeImageChoices}"
                                  SelectedItem="{Binding SelectedNodeImage}"
                                  DisplayMemberPath="Label" />
                    </DockPanel>
                </Border>
                <img:ImageViewerWorkspaceControl x:Name="ImageViewerControl" />
            </DockPanel>
        </Grid>
        </ScrollViewer>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#161D27" BorderBrush="#293548" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
