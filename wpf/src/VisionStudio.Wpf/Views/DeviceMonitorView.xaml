<UserControl x:Class="VisionStudio.Wpf.Views.DeviceMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:img="clr-namespace:VisionStudio.Wpf.Controls.ImageViewer"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="#0F141B">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="6" Padding="10,9" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="刷新设备快照" Command="{Binding RefreshCommand}" Padding="10,5" Margin="0,2,6,2" />
                    <Button Content="打开并采集相机" Command="{Binding OpenAndStartCameraCommand}"
                            Style="{StaticResource SuccessButtonStyle}" Padding="10,5" Margin="0,2,6,2" />
                    <Button Content="单次直采" Command="{Binding GrabLiveFrameCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" Margin="0,2,6,2" />
                    <Button Content="软触发取图" Command="{Binding TriggerAndGrabCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" Margin="0,2,6,2" />
                    <ToggleButton Content="连续预览" IsChecked="{Binding IsLivePreviewActive}"
                                  Padding="10,5" Margin="0,2,6,2"
                                  Background="#212B38" Foreground="#86EFAC" BorderBrush="#334155" />
                    <Button Content="停止并关闭相机" Command="{Binding StopAndCloseCameraCommand}"
                            Style="{StaticResource DangerButtonStyle}" Padding="10,5" Margin="0,2,0,2" />
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                    <Border CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#422B0F" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusConfirmed}" Value="True">
                                        <Setter Property="Background" Value="#143D2B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FreshnessText}" FontSize="11.5" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FCD34D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusConfirmed}" Value="True">
                                            <Setter Property="Foreground" Value="#86EFAC" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Background="#1B222C" BorderBrush="#293548" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock Foreground="#CBD5E1" FontSize="11.5">
                            <Run Text="相机已打开 " /><Run Text="{Binding OpenCameraCount, Mode=OneWay}" Foreground="#93C5FD" FontWeight="SemiBold" />
                            <Run Text=" · 采集中 " /><Run Text="{Binding RunningCameraCount, Mode=OneWay}" Foreground="#86EFAC" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Background="#1B222C" BorderBrush="#293548" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock Foreground="#CBD5E1" FontSize="11.5">
                            <Run Text="PLC在线 " /><Run Text="{Binding OnlineDeviceCount, Mode=OneWay}" Foreground="#86EFAC" FontWeight="SemiBold" />
                            <Run Text=" · 机器人在线 " /><Run Text="{Binding OnlineRobotCount, Mode=OneWay}" Foreground="#86EFAC" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding SelectedCameraSummary}" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Background="#141A22" BorderBrush="#293548">
                <TabItem Header="相机与参数">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0.85*" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"
                                  IsEnabled="{Binding CanOperate}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="95" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="驱动" Binding="{Binding Driver}" Width="80" />
                                <DataGridTemplateColumn Header="状态" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding State, Converter={StaticResource StatusBgBrush}}"
                                                    CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding State}"
                                                           Foreground="{Binding State, Converter={StaticResource StatusFgBrush}}"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="采集" Binding="{Binding Acquisition.AcquisitionState}" Width="85" />
                                <DataGridTextColumn Header="FPS" Binding="{Binding Acquisition.ActualFps, StringFormat=F1}" Width="50" />
                                <DataGridTextColumn Header="帧数" Binding="{Binding FramesCaptured}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1" Background="#161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,6">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="曝光(us)：" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,2,4,2" />
                                <TextBox Text="{Binding ExposureUsText, UpdateSourceTrigger=PropertyChanged}" Width="75" Margin="0,2,8,2" Padding="4,3" />
                                <TextBlock Text="增益(dB)：" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,2,4,2" />
                                <TextBox Text="{Binding GainDbText, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="0,2,8,2" Padding="4,3" />
                                <TextBlock Text="帧率：" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,2,4,2" />
                                <TextBox Text="{Binding TargetFpsText, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="0,2,8,2" Padding="4,3" />
                                <TextBlock Text="触发：" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,2,4,2" />
                                <ComboBox ItemsSource="{Binding TriggerModes}" SelectedItem="{Binding SelectedTriggerMode}" Width="105" Margin="0,2,8,2" />
                                <Button Content="应用参数" Command="{Binding ApplyCameraSettingsCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="10,4" Margin="0,2,6,2" />
                                <Button Content="读高级特性" Command="{Binding LoadCameraFeaturesCommand}" Padding="10,4" Margin="0,2,0,2" />
                            </WrapPanel>
                        </Border>

                        <GroupBox Grid.Row="2" Header="相机高级特性 (GenICam)" Foreground="#CBD5E1">
                            <DataGrid ItemsSource="{Binding CameraFeatures}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="95" />
                                    <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="140" />
                                    <DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="100" />
                                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="55" />
                                    <DataGridCheckBoxColumn Header="可写" Binding="{Binding Writable}" Width="50" />
                                    <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="PLC / 工业设备">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.15*" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="90" />
                                <DataGridTemplateColumn Header="连接状态" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ConnectionState, Converter={StaticResource StatusBgBrush}}"
                                                    CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ConnectionState}"
                                                           Foreground="{Binding ConnectionState, Converter={StaticResource StatusFgBrush}}"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="轮询" Binding="{Binding Stats.PollCycles}" Width="65" />
                                <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="1" Margin="0,6,0,6" VerticalAlignment="Center">
                            <Button Content="连接设备" Command="{Binding ConnectDeviceCommand}" Style="{StaticResource SuccessButtonStyle}" Padding="10,4" Margin="0,2,6,2" />
                            <Button Content="断开设备" Command="{Binding DisconnectDeviceCommand}" Style="{StaticResource DangerButtonStyle}" Padding="10,4" Margin="0,2,6,2" />
                            <Button Content="刷新标签读数" Command="{Binding RefreshDeviceTagsCommand}" Padding="10,4" Margin="0,2,10,2" />
                            <TextBlock Text="写入值：" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,2,4,2" />
                            <TextBox Text="{Binding TagWriteValueText, UpdateSourceTrigger=PropertyChanged}" Width="105" Margin="0,2,6,2" Padding="4,3" />
                            <Button Content="写入所选标签" Command="{Binding WriteDeviceTagCommand}" Padding="10,4" Margin="0,2,0,2"
                                    Background="#D97706" Foreground="White" BorderBrush="#F59E0B" />
                        </WrapPanel>

                        <GroupBox Grid.Row="2" Header="设备标签列表" Foreground="#CBD5E1">
                            <DataGrid ItemsSource="{Binding DeviceTags}" SelectedItem="{Binding SelectedDeviceTag}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TagId" Binding="{Binding TagId}" Width="100" />
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="115" />
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="85" />
                                    <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="75" />
                                    <DataGridCheckBoxColumn Header="可写" Binding="{Binding Writable}" Width="48" />
                                    <DataGridTextColumn Header="当前值" Binding="{Binding ValueText}" Width="*" />
                                    <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="机器人控制">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding Robots}" SelectedItem="{Binding SelectedRobot}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="品牌" Binding="{Binding Vendor}" Width="80" />
                                <DataGridTemplateColumn Header="连接状态" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ConnectionState, Converter={StaticResource StatusBgBrush}}"
                                                    CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ConnectionState}"
                                                           Foreground="{Binding ConnectionState, Converter={StaticResource StatusFgBrush}}"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="握手" Binding="{Binding HandshakeState}" Width="90" />
                                <DataGridCheckBoxColumn Header="仿真" Binding="{Binding Simulated}" Width="50" />
                                <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1" Background="#161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedRobotSummary}" Foreground="#93C5FD" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="连接机器人" Command="{Binding ConnectRobotCommand}" Style="{StaticResource SuccessButtonStyle}" Padding="10,4" Margin="0,0,6,0" />
                                    <Button Content="断开机器人" Command="{Binding DisconnectRobotCommand}" Padding="10,4" Margin="0,0,6,0" />
                                    <Button Content="停止运动" Command="{Binding StopRobotCommand}" Style="{StaticResource DangerButtonStyle}" Padding="10,4" Margin="0,0,6,0" />
                                    <Button Content="故障复位" Command="{Binding ResetRobotFaultCommand}" Padding="10,4"
                                            Background="#D97706" Foreground="White" BorderBrush="#F59E0B" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

            <GroupBox Grid.Column="2" Header="相机实时预览画面" Foreground="#CBD5E1">
                <img:ImageViewerWorkspaceControl x:Name="CameraViewerControl" />
            </GroupBox>
        </Grid>

        <Border Grid.Row="2" Background="#161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
