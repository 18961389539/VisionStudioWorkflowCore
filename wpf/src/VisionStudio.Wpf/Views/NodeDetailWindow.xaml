<Window x:Class="VisionStudio.Wpf.Views.NodeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:themes="clr-namespace:VisionStudio.Wpf.Themes"
        xmlns:img="clr-namespace:VisionStudio.Wpf.Controls.ImageViewer"
        mc:Ignorable="d"
        Title="节点详情与参数配置"
        Width="820" Height="660" MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0F141B" Foreground="#E2E8F0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部信息 -->
        <Border Grid.Row="0" Background="#161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="节点名称" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                        <TextBox Text="{Binding NodeTitle, UpdateSourceTrigger=PropertyChanged}" Width="250" />
                        <Border Background="#172E4F" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CategoryZh}" Foreground="#93C5FD" FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="#422B0F" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsNonStableMaturity, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding MaturityBadge}" Foreground="#FDE68A" FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Margin="0,7,0,0" Foreground="#64748B" FontSize="11.5">
                        <Run Text="ID: " />
                        <Run Text="{Binding NodeId, Mode=OneWay}" Foreground="#CBD5E1" FontFamily="Consolas" />
                        <Run Text="   ·   类型: " />
                        <Run Text="{Binding NodeType, Mode=OneWay}" Foreground="#CBD5E1" FontFamily="Consolas" />
                    </TextBlock>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#94A3B8" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{Binding ExecutionStateKey, Converter={StaticResource StatusBgBrush}}"
                        BorderBrush="#293548" BorderThickness="1"
                        CornerRadius="5" Padding="10,6" VerticalAlignment="Top" MaxWidth="220">
                    <TextBlock Text="{Binding StatusSummary}"
                               Foreground="{Binding ExecutionStateKey, Converter={StaticResource StatusFgBrush}}"
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- 主体分页：参数配置 / 端口与数值 / 节点图像 -->
        <TabControl Grid.Row="1" Background="#141A22" BorderBrush="#293548" BorderThickness="1">
            <TabItem Header="参数配置">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 参数过滤条 -->
                    <Border Grid.Row="0" Background="#161D27" BorderBrush="#243042" BorderThickness="0,0,0,1" Padding="12,8">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="4" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Foreground="#94A3B8" FontSize="11.5">
                                    <Run Text="显示 " /><Run Text="{Binding VisibleParameterCount, Mode=OneWay}" Foreground="#93C5FD" FontWeight="SemiBold" />
                                    <Run Text=" / " /><Run Text="{Binding ActiveParameterCount, Mode=OneWay}" />
                                    <Run Text=" 项有效参数" />
                                </TextBlock>
                            </Border>
                            <Grid>
                                <TextBox Text="{Binding ParameterFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,5,26,5"
                                         themes:TextBoxHelper.Placeholder="筛选参数名称、键名、分组或说明..." />
                                <Button Content="×" Command="{Binding ClearParameterFilterCommand}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,4,0" Padding="5,1"
                                        Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                        Visibility="{Binding ParameterFilter, Converter={StaticResource NotEmptyToVis}}"
                                        ToolTip="清空参数筛选" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding GroupedParameters}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="#18212E" BorderBrush="#243042" BorderThickness="0,0,0,1"
                                                        CornerRadius="4" Padding="10,5" Margin="0,8,0,6">
                                                    <TextBlock Text="{Binding Name}" Foreground="#93C5FD" FontWeight="SemiBold" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1B222C" BorderBrush="#293548" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="68" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" Foreground="#F1F5F9" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text=" *" Foreground="#F87171" FontWeight="Bold"
                                                                   Visibility="{Binding IsRequired, Converter={StaticResource BoolToVis}}"
                                                                   ToolTip="必填参数" />
                                                    </WrapPanel>
                                                    <WrapPanel Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="#64748B" FontSize="11" FontFamily="Consolas" />
                                                        <TextBlock Text="{Binding RangeHint, StringFormat=' · {0}'}" Foreground="#64748B" FontSize="10.5"
                                                                   Visibility="{Binding RangeHint, Converter={StaticResource NotEmptyToVis}}" />
                                                    </WrapPanel>
                                                </StackPanel>

                                                <Grid Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding BoolValue}"
                                                              Content="启用"
                                                              Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVis}}" />

                                                    <ComboBox ItemsSource="{Binding Options}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Value"
                                                              SelectedValue="{Binding TextValue}"
                                                              Visibility="{Binding IsSelect, Converter={StaticResource BoolToVis}}" />

                                                    <StackPanel Visibility="{Binding IsRoi, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding RoiSummaryText}" Foreground="#86EFAC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                        <WrapPanel>
                                                            <Button Content="从主图导入ROI"
                                                                    Command="{Binding DataContext.ImportRoiFromViewerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding DataContext.HasViewerRoiBridge, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                                    Padding="9,4" Margin="0,0,6,4" />
                                                            <Button Content="在主图高亮"
                                                                    Command="{Binding DataContext.PreviewRoiInViewerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding DataContext.HasViewerRoiBridge, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Padding="9,4" Margin="0,0,6,4" />
                                                            <Button Content="清除ROI"
                                                                    Command="{Binding DataContext.ClearRoiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="9,4" Margin="0,0,0,4" Foreground="#FCA5A5" />
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                                                        <Setter Property="AcceptsReturn" Value="True" />
                                                                        <Setter Property="Height" Value="130" />
                                                                        <Setter Property="FontFamily" Value="Consolas" />
                                                                        <Setter Property="VerticalContentAlignment" Value="Top" />
                                                                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>

                                                <StackPanel Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Unit}" Foreground="#94A3B8" FontSize="11.5" HorizontalAlignment="Center" />
                                                    <Button Content="浏览" Command="{Binding BrowsePathCommand}"
                                                            Padding="8,4"
                                                            Visibility="{Binding IsPath, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                                           Text="{Binding Description}" Foreground="#94A3B8" FontSize="11.5"
                                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Visibility="{Binding Description, Converter={StaticResource NotEmptyToVis}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="#161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="6"
                                    Padding="20,16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0"
                                    Visibility="{Binding HasNoVisibleParameters, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="当前没有匹配的可配置参数（可清空筛选词或查看“端口与运行快照”）"
                                           Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="端口与运行快照">
                <DataGrid ItemsSource="{Binding Ports}" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="方向" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#143D2B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="输入">
                                                        <Setter Property="Background" Value="#172E4F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Direction}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#86EFAC" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="输入">
                                                            <Setter Property="Foreground" Value="#93C5FD" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="端口名" Binding="{Binding PortName}" Width="140" />
                        <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="130" />
                        <DataGridTemplateColumn Header="约束" Width="68">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#232C3B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Required}" Value="True">
                                                        <Setter Property="Background" Value="#422B0F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="可选" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Required}" Value="True">
                                                            <Setter Property="Text" Value="必填" />
                                                            <Setter Property="Foreground" Value="#FCD34D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="最近一次执行值" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LatestValue}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding LatestValue}" FontFamily="Consolas" FontSize="11.5" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="节点图像输出">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="推送到主图像区" Command="{Binding PushToMainViewerCommand}"
                                IsEnabled="{Binding HasPreviewImage}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                DockPanel.Dock="Right" Padding="10,4" />
                        <TextBlock Text="{Binding NodePreviewCaption}" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Grid.Row="1" Background="#0D1117" BorderBrush="#293548" BorderThickness="1" CornerRadius="4">
                        <img:ImageViewerWorkspaceControl x:Name="NodePreviewViewer"
                                                         ImageSource="{Binding NodePreviewImage}" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 错误提示 -->
        <Border Grid.Row="2" Background="#451A1E" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="5"
                Padding="10,6" Margin="0,8,0,0"
                Visibility="{Binding ValidationError, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding ValidationError}" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- 底部操作按钮 -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button Content="恢复默认参数" Command="{Binding ResetDefaultsCommand}" DockPanel.Dock="Left" Padding="12,6" />
            <Button Content="取消" Click="OnCancelClick" IsCancel="True" DockPanel.Dock="Right" Padding="14,6" Margin="8,0,0,0" />
            <Button Content="确定并应用" Click="OnConfirmClick" IsDefault="True" DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" />
        </DockPanel>
    </Grid>
</Window>
