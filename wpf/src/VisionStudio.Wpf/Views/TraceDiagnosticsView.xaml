<UserControl x:Class="VisionStudio.Wpf.Views.TraceDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:themes="clr-namespace:VisionStudio.Wpf.Themes"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="#0F141B">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏与资产健康汇总 -->
        <Border Grid.Row="0" Background="#161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="6" Padding="10,9" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="刷新追溯与资产健康" Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="12,5" Margin="0,2,6,2" />
                    <Button Content="清空实时日志" Command="{Binding ClearLogsCommand}" Padding="12,5" Margin="0,2,8,2" />
                    <Grid Width="210" Margin="0,2,6,2">
                        <TextBox Text="{Binding TraceFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5,26,5"
                                 themes:TextBoxHelper.Placeholder="筛选 RunId 或流程名"
                                 ToolTip="在最近 100 条记录中按 RunId 或流程名称过滤，再点击刷新" />
                        <Button Content="×" Command="{Binding ClearTraceFilterCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0" Padding="5,1"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                Visibility="{Binding TraceFilter, Converter={StaticResource NotEmptyToVis}}"
                                ToolTip="清空筛选条件" />
                    </Grid>
                    <Button Content="查看运行详情" Command="{Binding ViewTraceCommand}" Padding="12,5" Margin="0,2,6,2" />
                    <Button Content="载入快照到编辑器" Command="{Binding LoadTraceWorkflowToEditorCommand}" Padding="12,5" Margin="0,2,6,2" />
                    <Button Content="导出诊断包" Command="{Binding ExportBundleCommand}" Padding="12,5" Margin="0,2,0,2" />
                </WrapPanel>

                <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                    <Border CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#422B0F" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusConfirmed}" Value="True">
                                        <Setter Property="Background" Value="#143D2B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FreshnessText}" FontSize="11.5" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FCD34D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusConfirmed}" Value="True">
                                            <Setter Property="Foreground" Value="#86EFAC" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Background="#143D2B" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                        <TextBlock Foreground="#86EFAC" FontSize="11.5" FontWeight="SemiBold">
                            <Run Text="正常 " /><Run Text="{Binding HealthyCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Background="#422B0F" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                        <TextBlock Foreground="#FCD34D" FontSize="11.5" FontWeight="SemiBold">
                            <Run Text="降级 " /><Run Text="{Binding DegradedCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Background="#451A1E" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                        <TextBlock Foreground="#FCA5A5" FontSize="11.5" FontWeight="SemiBold">
                            <Run Text="故障 " /><Run Text="{Binding FaultedCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Background="#232C3B" CornerRadius="4" Padding="7,2" Margin="0,0,10,0">
                        <TextBlock Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold">
                            <Run Text="离线 " /><Run Text="{Binding OfflineCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding DiagnosticsSummaryText}" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="#93C5FD" FontSize="12" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 主体四象限分栏：上（运行追溯 + 资产健康），下（运行详情 JSON + Serilog 实时日志） -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.15*" MinHeight="140" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" MinHeight="140" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0">
                    <GroupBox.Header>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="双击记录加载详情" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="运行追溯记录（SQLite TraceabilityStore）" Foreground="#CBD5E1" FontWeight="SemiBold" />
                        </DockPanel>
                    </GroupBox.Header>
                    <DataGrid ItemsSource="{Binding TraceRecords}" SelectedItem="{Binding SelectedTrace}"
                              MouseDoubleClick="OnTraceRowDoubleClick"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding StartedAt, StringFormat=MM-dd HH:mm:ss}" Width="120" />
                            <DataGridTextColumn Header="RunId" Binding="{Binding RunId}" Width="115" />
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="85" />
                            <DataGridTextColumn Header="流程" Binding="{Binding WorkflowName}" Width="*" />
                            <DataGridTemplateColumn Header="判定" Width="74">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Disposition, Converter={StaticResource StatusBgBrush}}"
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Disposition}"
                                                       Foreground="{Binding Disposition, Converter={StaticResource StatusFgBrush}}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="耗时(ms)" Binding="{Binding TotalDurationMs, StringFormat=F1}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

                <GroupBox Grid.Column="2" Header="资产健康状态" Foreground="#CBD5E1">
                    <DataGrid ItemsSource="{Binding AssetHealth}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="75" />
                            <DataGridTextColumn Header="资产 ID" Binding="{Binding Id}" Width="105" />
                            <DataGridTemplateColumn Header="健康度" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Level, Converter={StaticResource StatusBgBrush}}"
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Level}"
                                                       Foreground="{Binding Level, Converter={StaticResource StatusFgBrush}}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90" />
                            <DataGridTextColumn Header="错误说明" Binding="{Binding Error}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TabControl Grid.Column="0" Background="#141A22" BorderBrush="#293548">
                    <TabItem Header="运行详情与节点报告">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DataGrid Grid.Column="0" ItemsSource="{Binding SelectedTraceNodeReports}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding ExecutionSequence}" Width="50" />
                                    <DataGridTextColumn Header="节点 ID" Binding="{Binding NodeId}" Width="110" />
                                    <DataGridTextColumn Header="类型" Binding="{Binding NodeType}" Width="135" />
                                    <DataGridCheckBoxColumn Header="成功" Binding="{Binding Success}" Width="46" />
                                    <DataGridTextColumn Header="耗时(ms)" Binding="{Binding DurationMs, StringFormat=F2}" Width="75" />
                                    <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

                            <GroupBox Grid.Column="2">
                                <GroupBox.Header>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="复制详情" Click="OnCopyTraceDetailsClick"
                                                Padding="8,2" FontSize="11" Margin="8,0,0,0" />
                                        <TextBlock Text="运行详情（JSON）" Foreground="#CBD5E1" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                </GroupBox.Header>
                                <TextBox x:Name="TraceDetailsBox"
                                         Text="{Binding TraceDetails, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="11.5"
                                         BorderThickness="0" />
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="节点耗时遥测 (P95 / Span)">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="节点耗时分布与建议超时" Foreground="#CBD5E1">
                                <DataGrid ItemsSource="{Binding NodeDurations}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="节点类型" Binding="{Binding NodeType}" Width="140" />
                                        <DataGridTextColumn Header="样本" Binding="{Binding Samples}" Width="50" />
                                        <DataGridTextColumn Header="P50(ms)" Binding="{Binding P50Ms, StringFormat=F1}" Width="65" />
                                        <DataGridTextColumn Header="P95(ms)" Binding="{Binding P95Ms, StringFormat=F1}" Width="65" />
                                        <DataGridTextColumn Header="最大(ms)" Binding="{Binding MaxMs, StringFormat=F1}" Width="65" />
                                        <DataGridTextColumn Header="建议超时" Binding="{Binding SuggestedTimeoutMs}" Width="70" />
                                        <DataGridTextColumn Header="超时次数" Binding="{Binding TimeoutCount}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

                            <GroupBox Grid.Column="2" Header="最近单次节点执行 Span" Foreground="#CBD5E1">
                                <DataGrid ItemsSource="{Binding RecentNodeSpans}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding At, StringFormat=HH:mm:ss.fff}" Width="90" />
                                        <DataGridTextColumn Header="节点 ID" Binding="{Binding NodeId}" Width="105" />
                                        <DataGridTextColumn Header="类型" Binding="{Binding NodeType}" Width="125" />
                                        <DataGridTextColumn Header="耗时(ms)" Binding="{Binding DurationMs, StringFormat=F2}" Width="70" />
                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="55" />
                                        <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="数据集批量验证">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,2,0,6" VerticalAlignment="Center">
                                <TextBlock Text="数据集：" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox ItemsSource="{Binding ValidationDatasets}" SelectedItem="{Binding SelectedValidationDataset}"
                                          DisplayMemberPath="Name" Width="170" Margin="0,0,6,0" />
                                <Button Content="新建数据集" Command="{Binding CreateValidationDatasetCommand}" Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="加入选中追溯" Command="{Binding AddTraceToDatasetCommand}" Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="执行批量验证" Command="{Binding RunValidationDatasetCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ValidationSummaryText}" Foreground="#93C5FD" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </WrapPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Grid.Column="0" Header="数据集样本" Foreground="#CBD5E1">
                                    <DataGrid ItemsSource="{Binding ValidationDatasetItems}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="来源" Binding="{Binding SourceKind}" Width="60" />
                                            <DataGridTextColumn Header="名称/引用" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTextColumn Header="期望" Binding="{Binding ExpectedDisposition}" Width="50" />
                                            <DataGridCheckBoxColumn Header="可回放" Binding="{Binding ReplayReady}" Width="50" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />
                                <GroupBox Grid.Column="2" Header="验证结果明细" Foreground="#CBD5E1">
                                    <DataGrid ItemsSource="{Binding ValidationResults}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="样本引用" Binding="{Binding SourceRef}" Width="110" />
                                            <DataGridTextColumn Header="期望" Binding="{Binding ExpectedDisposition}" Width="50" />
                                            <DataGridTextColumn Header="实际" Binding="{Binding ActualDisposition}" Width="50" />
                                            <DataGridTextColumn Header="分类" Binding="{Binding Classification}" Width="80" />
                                            <DataGridTextColumn Header="耗时(ms)" Binding="{Binding DurationMs, StringFormat=F1}" Width="70" />
                                            <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

                <GroupBox Grid.Column="2" Header="Serilog 实时运行日志（同步落盘到数据根/logs）" Foreground="#CBD5E1">
                    <DataGrid x:Name="LogsDataGrid" ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="98" />
                            <DataGridTemplateColumn Header="级别" Width="68">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Level, Converter={StaticResource StatusBgBrush}}"
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Level}"
                                                       Foreground="{Binding Level, Converter={StaticResource StatusFgBrush}}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="模块" Binding="{Binding Source}" Width="140" />
                            <DataGridTextColumn Header="日志内容" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
