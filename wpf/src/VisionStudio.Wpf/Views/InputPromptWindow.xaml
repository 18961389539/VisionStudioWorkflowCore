<Window x:Class="VisionStudio.Wpf.Views.InputPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="440" SizeToContent="Height" MinWidth="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#141A22" Foreground="#E2E8F0">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding PromptDescription}" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

        <TextBlock Text="{Binding PrimaryLabel}" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4" />
        <TextBox x:Name="PrimaryTextBox" Text="{Binding PrimaryValue, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8,6" Margin="0,0,0,10" />

        <StackPanel Visibility="{Binding ShowSecondary, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
            <TextBlock Text="{Binding SecondaryLabel}" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4" />
            <TextBox Text="{Binding SecondaryValue, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
        </StackPanel>

        <StackPanel Visibility="{Binding ShowCheckbox, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
            <CheckBox IsChecked="{Binding CheckboxValue}" Content="{Binding CheckboxLabel}"
                      Foreground="#FCD34D" FontSize="12" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorText}" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" IsDefault="True" Click="OnOkClick"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="18,6" Margin="0,0,8,0" />
            <Button Content="取消" IsCancel="True" Click="OnCancelClick" Padding="14,6" />
        </StackPanel>
    </StackPanel>
</Window>
