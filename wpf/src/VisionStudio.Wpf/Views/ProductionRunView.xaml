<UserControl x:Class="VisionStudio.Wpf.Views.ProductionRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:img="clr-namespace:VisionStudio.Wpf.Controls.ImageViewer"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="#0F141B">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 生产控制工具栏 -->
        <Border Grid.Row="0" Background="#161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="6" Padding="10,9" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="初始化试用工单" Command="{Binding InitializeTrialCommand}" Padding="10,5" Margin="0,2,6,2" />
                    <Button Content="发布当前流程为工单" Command="{Binding PublishEditorWorkflowCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" Margin="0,2,10,2" />
                    <TextBlock Text="目标工单" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,2,6,2" FontSize="12" />
                    <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                              IsEnabled="{Binding CanOperate}"
                              DisplayMemberPath="Name" Width="205" Margin="0,2,10,2" />
                    <Button Content="刷新状态" Command="{Binding RefreshCommand}" Padding="10,5" Margin="0,2,6,2" />
                    <Button Content="启动生产" Command="{Binding StartProductionCommand}"
                            Style="{StaticResource SuccessButtonStyle}" Padding="12,5" Margin="0,2,6,2" />
                    <Button Content="单次触发" Command="{Binding TriggerOnceCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" Margin="0,2,6,2" />
                    <Button Content="停止生产" Command="{Binding StopProductionCommand}"
                            Style="{StaticResource DangerButtonStyle}" Padding="12,5" Margin="0,2,6,2" />
                    <Button Content="故障恢复" Command="{Binding RecoverProductionCommand}"
                            Style="{StaticResource WarningButtonStyle}" Padding="10,5" Margin="0,2,6,2" />
                    <Button Content="全部启动" Command="{Binding StartAllStationsCommand}" Padding="10,5" Margin="0,2,6,2"
                            Foreground="#86EFAC" />
                    <Button Content="全部停止" Command="{Binding StopAllStationsCommand}" Padding="10,5" Margin="0,2,6,2"
                            Foreground="#FCA5A5" />
                    <Button Content="确认所选报警" Command="{Binding AcknowledgeAlarmCommand}" Padding="10,5" Margin="0,2,0,2" />
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                    <Border CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#422B0F" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusConfirmed}" Value="True">
                                        <Setter Property="Background" Value="#143D2B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FreshnessText}" FontSize="11.5" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FCD34D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusConfirmed}" Value="True">
                                            <Setter Property="Foreground" Value="#86EFAC" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding LatestResultSummary}" Foreground="#93C5FD" FontSize="12" VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 生产 KPI 概览条 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <Border Background="#141A22" BorderBrush="#293548" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="运行工位 / 总工位" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" Margin="0,2,0,0">
                        <Run Text="{Binding RunningStations, Mode=OneWay}" Foreground="#86EFAC" />
                        <Run Text=" / " Foreground="#64748B" />
                        <Run Text="{Binding TotalStations, Mode=OneWay}" />
                        <Run Text="  (故障 " Foreground="#94A3B8" FontSize="11" FontWeight="Normal" />
                        <Run Text="{Binding FaultedStations, Mode=OneWay}" Foreground="#FCA5A5" FontSize="11" FontWeight="SemiBold" />
                        <Run Text=")" Foreground="#94A3B8" FontSize="11" FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="#141A22" BorderBrush="#293548" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="累计生产周期" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding TotalCycles}" Foreground="#93C5FD" FontSize="17" FontWeight="Bold" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Background="#141A22" BorderBrush="#293548" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="良率 (OK / NG / Err)" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" Margin="0,2,0,0">
                        <Run Text="{Binding YieldRateText, Mode=OneWay}" Foreground="#86EFAC" />
                        <Run Text="  (" Foreground="#64748B" FontSize="11" FontWeight="Normal" />
                        <Run Text="{Binding TotalOk, Mode=OneWay}" Foreground="#86EFAC" FontSize="11" />
                        <Run Text="/" Foreground="#64748B" FontSize="11" />
                        <Run Text="{Binding TotalNg, Mode=OneWay}" Foreground="#FCD34D" FontSize="11" />
                        <Run Text="/" Foreground="#64748B" FontSize="11" />
                        <Run Text="{Binding TotalErrors, Mode=OneWay}" Foreground="#FCA5A5" FontSize="11" />
                        <Run Text=")" Foreground="#64748B" FontSize="11" FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="#141A22" BorderBrush="#293548" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="当前活动报警" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding ActiveAlarmCount}" FontSize="17" FontWeight="Bold" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#86EFAC" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveAlarmCount, Converter={StaticResource NonZeroToVis}}" Value="Visible">
                                        <Setter Property="Foreground" Value="#FCA5A5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 主体工作区：左 工位与报警/版本/SPC | 右 实时生产图像预览 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Background="#141A22" BorderBrush="#293548" BorderThickness="1">
                <TabItem Header="工位与报警">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.3*" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="工位运行状态" Foreground="#CBD5E1">
                            <DataGrid ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                                      IsEnabled="{Binding CanOperate}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="工位 ID" Binding="{Binding StationId}" Width="95" />
                                    <DataGridTemplateColumn Header="状态" Width="88">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding State, Converter={StaticResource StatusBgBrush}}"
                                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding State}"
                                                               Foreground="{Binding State, Converter={StaticResource StatusFgBrush}}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="当前工单" Binding="{Binding JobId}" Width="120" />
                                    <DataGridTextColumn Header="周期" Binding="{Binding CycleCount}" Width="62" />
                                    <DataGridTextColumn Header="OK" Binding="{Binding OkCount}" Width="52" />
                                    <DataGridTextColumn Header="NG" Binding="{Binding NgCount}" Width="52" />
                                    <DataGridTextColumn Header="错误" Binding="{Binding ErrorCount}" Width="52" />
                                    <DataGridTextColumn Header="耗时(ms)" Binding="{Binding LastDurationMs, StringFormat=F1}" Width="75" />
                                    <DataGridTemplateColumn Header="判定" Width="68">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding LastDisposition, Converter={StaticResource StatusBgBrush}}"
                                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding LastDisposition}"
                                                               Foreground="{Binding LastDisposition, Converter={StaticResource StatusFgBrush}}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="最近错误" Binding="{Binding LastError}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />

                        <GroupBox Grid.Row="2">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="报警队列" Foreground="#FCA5A5" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                                    <CheckBox IsChecked="{Binding ShowAllAlarms}" Content="包含已确认历史报警" VerticalAlignment="Center" />
                                </StackPanel>
                            </GroupBox.Header>
                            <DataGrid ItemsSource="{Binding ActiveAlarms}" SelectedItem="{Binding SelectedAlarm}"
                                      IsEnabled="{Binding CanOperate}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding RaisedAt, StringFormat=MM-dd HH:mm:ss}" Width="125" />
                                    <DataGridTemplateColumn Header="级别" Width="82">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Severity, Converter={StaticResource StatusBgBrush}}"
                                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Severity}"
                                                               Foreground="{Binding Severity, Converter={StaticResource StatusFgBrush}}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Header="已确认" Binding="{Binding Acknowledged}" Width="60" />
                                    <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="110" />
                                    <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="110" />
                                    <DataGridTextColumn Header="报警内容" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="工单版本与回滚">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,4,0,8" VerticalAlignment="Center">
                            <TextBlock Text="管理工单" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,2,6,2" />
                            <ComboBox ItemsSource="{Binding AllJobs}" SelectedItem="{Binding SelectedManagedJob}"
                                      DisplayMemberPath="Name" Width="210" Margin="0,2,8,2" />
                            <Button Content="发布/回滚所选版本" Command="{Binding PublishSelectedVersionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="10,4" Margin="0,2,6,2" />
                            <Button Content="载入所选版本到编辑器" Command="{Binding LoadJobVersionToEditorCommand}"
                                    Padding="10,4" Margin="0,2,0,2" />
                        </WrapPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedJobVersions}" SelectedItem="{Binding SelectedJobVersion}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="版本" Binding="{Binding Version, StringFormat=V{0}}" Width="65" />
                                <DataGridCheckBoxColumn Header="当前发布" Binding="{Binding Published}" Width="75" />
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                                <DataGridTextColumn Header="流程哈希" Binding="{Binding WorkflowHash}" Width="150" />
                                <DataGridTextColumn Header="版本备注" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="SPC 过程统计">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,4,0,8" VerticalAlignment="Center">
                            <TextBlock Text="数据集" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,2,6,2" />
                            <ComboBox ItemsSource="{Binding SpcDatasets}" SelectedItem="{Binding SelectedSpcDataset}"
                                      DisplayMemberPath="Dataset" Width="170" Margin="0,2,8,2" />
                            <TextBlock Text="LSL" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,2,4,2" />
                            <TextBox Text="{Binding SpcLslText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,2,8,2" Padding="5,4" />
                            <TextBlock Text="USL" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,2,4,2" />
                            <TextBox Text="{Binding SpcUslText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,2,8,2" Padding="5,4" />
                            <Button Content="分析 SPC" Command="{Binding AnalyzeSpcCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="10,4" Margin="0,2,0,2" />
                        </WrapPanel>
                        <TextBlock Grid.Row="1" Text="{Binding SpcSummaryText}" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <GroupBox Grid.Row="0" Header="SPC 规则违规 (Western Electric)" Foreground="#FCA5A5">
                                <DataGrid ItemsSource="{Binding SpcViolations}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="规则" Binding="{Binding Rule}" Width="90" />
                                        <DataGridTextColumn Header="起止点" Binding="{Binding StartIndex}" Width="70" />
                                        <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />
                            <GroupBox Grid.Row="2" Header="最近样本点 (I 图)" Foreground="#CBD5E1">
                                <DataGrid ItemsSource="{Binding SpcPoints}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="70" />
                                        <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=MM-dd HH:mm:ss}" Width="140" />
                                        <DataGridTextColumn Header="测量值" Binding="{Binding Value, StringFormat=F4}" Width="110" />
                                        <DataGridCheckBoxColumn Header="越界" Binding="{Binding BeyondLimits}" Width="65" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

            <GroupBox Grid.Column="2" Header="产线最新结果图像预览" Foreground="#CBD5E1">
                <img:ImageViewerWorkspaceControl x:Name="ProductionPreviewViewer" />
            </GroupBox>
        </Grid>

        <Border Grid.Row="3" Background="#161D27" BorderBrush="#293548" BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
