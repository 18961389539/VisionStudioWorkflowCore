<Window x:Class="VisionStudio.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:VisionStudio.Wpf.Views"
        mc:Ignorable="d"
        Title="VisionStudio · 内部试用桌面控制台"
        Width="1480" Height="900" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#0F141B" Foreground="#E2E8F0">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Editor.SaveWorkflowCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding Editor.NewWorkflowCommand}" />
        <KeyBinding Key="F5" Command="{Binding Editor.RunWorkflowCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Editor.CancelRunCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏导航标识与全局状态 -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#293548" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <!-- 右侧全局实时状态胶囊 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Background="#172E4F" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4"
                                Padding="8,2" Margin="0,0,6,0"
                                Visibility="{Binding Editor.IsBusy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="流程运行中" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="#451A1E" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4"
                                Padding="8,2" Margin="0,0,6,0"
                                Visibility="{Binding Production.ActiveAlarmCount, Converter={StaticResource NonZeroToVis}}">
                            <TextBlock Foreground="#FCA5A5" FontSize="11" FontWeight="SemiBold">
                                <Run Text="活动报警 " /><Run Text="{Binding Production.ActiveAlarmCount, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <WrapPanel VerticalAlignment="Center">
                        <Border Width="4" Height="18" Background="#3B82F6" CornerRadius="2" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="VisionStudio WorkflowCore" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold">
                                <Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Background="#172E4F" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="内部试用 · 默认模拟/回放 · 真实硬件未验证" Foreground="#93C5FD" FontSize="11" />
                        </Border>
                    </WrapPanel>
                </DockPanel>

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="#64748B" FontSize="11" Margin="13,3,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DataRoot, Mode=OneWay}">
                    <Run Text="数据目录：" />
                    <Run Text="{Binding DataRoot, Mode=OneWay}" Foreground="#94A3B8" />
                    <Run Text="   ·   快捷键：Ctrl+S 保存 · Ctrl+N 新建 · F5 运行 · Esc 停止 · Del 删除节点" Foreground="#64748B" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- 四大主功能工作区 -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    Background="#0F141B" BorderThickness="0" SelectionChanged="OnMainTabSelectionChanged">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 1,3 L 5,3 L 5,7 L 1,7 Z M 9,1 L 13,1 L 13,5 L 9,5 Z M 9,8 L 13,8 L 13,12 L 9,12 Z M 5,5 L 9,3 M 5,5 L 9,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.3" Width="14" Height="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="流程编排与调试" VerticalAlignment="Center" />
                        <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="6,0,0,0" VerticalAlignment="Center"
                                 ToolTip="有未保存的修改"
                                 Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <views:WorkflowEditorView x:Name="EditorView" DataContext="{Binding Editor}" />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 2,11 L 2,6 M 6,11 L 6,2 M 10,11 L 10,5 M 14,11 L 14,8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="生产运行与工位" VerticalAlignment="Center" />
                        <Border Background="#B91C1C" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Production.ActiveAlarmCount, Converter={StaticResource NonZeroToVis}}">
                            <TextBlock Text="{Binding Production.ActiveAlarmCount}" Foreground="White" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <views:ProductionRunView x:Name="ProductionView" DataContext="{Binding Production}" />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 1,4 L 13,4 L 13,11 L 1,11 Z M 4,4 L 5,2 L 9,2 L 10,4 M 7,6.5 A 1.8,1.8 0 1 1 6.99,6.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.3" Width="14" Height="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="设备与相机监视" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:DeviceMonitorView x:Name="DevicesView" DataContext="{Binding Devices}" />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 2,2 L 12,2 L 12,12 L 2,12 Z M 4.5,5 L 9.5,5 M 4.5,7.5 L 9.5,7.5 M 4.5,10 L 7.5,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.3" Width="14" Height="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="追溯与运行诊断" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:TraceDiagnosticsView x:Name="DiagnosticsView" DataContext="{Binding Diagnostics}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
