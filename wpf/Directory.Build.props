<Project>
  <!--
    与 backend/Directory.Build.props 保持一致：固定 Roslyn 编译器工具集，确保 OpenCvSharp5 分析器与
    C# 语言特性在本地与 CI 下行为一致。
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      外部图像浏览控件（https://github.com/18961389539/ImageViewer）集成开关：
      默认引用仓库内 third_party/ImageViewer 源码，可通过以下参数指定其他位置：
        -p:ExternalImageViewerProject=D:\ImageViewer\ImageViewerControl\ImageViewerControl.csproj
      或使用 NuGet 包形式：
        -p:UseExternalImageViewer=true -p:UseExternalImageViewerPackage=true
      仅在显式传入 -p:UseExternalImageViewer=false 时使用内建 WPF 图像浏览实现。
    -->
    <UseExternalImageViewer Condition="'$(UseExternalImageViewer)' == ''">true</UseExternalImageViewer>
    <UseExternalImageViewerPackage Condition="'$(UseExternalImageViewerPackage)' == ''">false</UseExternalImageViewerPackage>
    <ExternalImageViewerProject Condition="'$(ExternalImageViewerProject)' == ''">$(MSBuildThisFileDirectory)..\third_party\ImageViewer\ImageViewerControl\ImageViewerControl.csproj</ExternalImageViewerProject>
    <DefineConstants Condition="'$(UseExternalImageViewer)' == 'true'">$(DefineConstants);USE_EXTERNAL_IMAGE_VIEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" PrivateAssets="all" />
  </ItemGroup>
</Project>
