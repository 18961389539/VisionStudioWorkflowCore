<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VisionStudio.Wpf\VisionStudio.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\samples\camera_frames\*.png" Link="samples\camera_frames\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\samples\defect-detection-workflow.json" Link="samples\defect-detection-workflow.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\samples\linear-workflow.json" Link="samples\linear-workflow.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
